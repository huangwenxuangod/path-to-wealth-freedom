/* ================================================================
   ink_jade — 新中式国潮 · 金融科技期末答辩
   单色 + 朱红 accent · 思源宋体 + 楷书 · 浅米和纸 + 0.04 纸纹
   v18 · 2026-06-22
   ================================================================ */
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;600;700;900&family=Ma+Shan+Zheng&family=ZCOOL+XiaoWei&family=JetBrains+Mono:wght@400;500;600;700&display=swap');

.tpl-ink-jade{
  --paper:        #f5f1e8;     /* 浅米和纸 */
  --paper-deep:   #ede5d2;     /* 深一档米色 */
  --paper-soft:   #faf6ec;     /* 浅一档米色 */
  --ink:          #1a1a1a;     /* 墨色 */
  --ink-2:        #5a4f44;     /* 暖深灰 */
  --ink-3:        #8b7d6b;     /* 暖浅灰 */
  --ink-border:        rgba(26,26,26,.10);
  --ink-border-strong: rgba(26,26,26,.28);
  --vermilion:    #c0392b;     /* 朱红 accent (唯一彩色) */
  --vermilion-soft:   rgba(192,57,43,.12);
  --vermilion-faint:  rgba(192,57,43,.04);
  --seal-ink:     #fff8e7;     /* 印章白 */
  --serif:        'Noto Serif SC','Source Han Serif SC','Songti SC','STSong',serif;
  --kai:          'Ma Shan Zheng','STKaiti','Kaiti SC',cursive;
  --mono:         'JetBrains Mono','IBM Plex Mono',monospace;
}

/* ============== 全局背景：米纸 + 0.04 噪点 ============== */
.tpl-ink-jade,
.tpl-ink-jade .deck{
  background: var(--paper) !important;
}
.tpl-ink-jade .deck{
  position: relative;
}
.tpl-ink-jade .deck::before{
  content:'';
  position: fixed; inset: 0;
  background-image:
    radial-gradient(circle at 13% 17%, rgba(0,0,0,.04) 1px, transparent 1.2px),
    radial-gradient(circle at 47% 53%, rgba(0,0,0,.025) 1px, transparent 1.2px),
    radial-gradient(circle at 79% 81%, rgba(0,0,0,.04) 1px, transparent 1.2px),
    radial-gradient(circle at 23% 73%, rgba(0,0,0,.02) .6px, transparent 1px),
    radial-gradient(circle at 67% 27%, rgba(0,0,0,.03) .6px, transparent 1px);
  background-size: 7px 7px, 11px 11px, 13px 13px, 5px 5px, 9px 9px;
  pointer-events: none;
  z-index: 100;
  mix-blend-mode: multiply;
  opacity: .85;
}

/* ============== 幻灯片底 ============== */
.tpl-ink-jade .slide{
  background: var(--paper) !important;
  color: var(--ink) !important;
  padding: 56px 80px 72px !important;
  font-family: var(--serif) !important;
  font-feature-settings: 'kern','liga','palt','calt';
  letter-spacing: .04em;
  box-sizing: border-box;
}
.tpl-ink-jade .slide.full{
  padding: 80px 96px !important;
}

/* ============== H1 / H2 / Kicker ============== */
.tpl-ink-jade .h1{
  font-family: var(--serif);
  font-size: 72px; line-height: 1.1;
  font-weight: 700; letter-spacing: .04em;
  color: var(--ink);
  margin: 0;
}
.tpl-ink-jade .h1 em{
  font-style: normal;
  color: var(--vermilion);
  font-family: var(--kai);
  font-weight: 400;
  letter-spacing: .12em;
}
.tpl-ink-jade .h2{
  font-family: var(--serif);
  font-size: 44px; line-height: 1.2;
  font-weight: 600; letter-spacing: .06em;
  color: var(--ink);
  margin: 0;
}
.tpl-ink-jade .h2 .grad{
  color: var(--vermilion);
  font-family: var(--kai);
  font-weight: 400;
  letter-spacing: .1em;
  font-size: 50px;
  display: inline-block;
  margin: 0 2px;
}
.tpl-ink-jade .kicker{
  font-family: var(--mono);
  font-size: 12px;
  color: var(--ink-3);
  letter-spacing: .28em;
  text-transform: uppercase;
  margin: 0;
  display: inline-flex;
  align-items: center;
  gap: 10px;
}
.tpl-ink-jade .kicker::before{
  content:'';
  display: inline-block;
  width: 24px; height: 1.5px;
  background: var(--vermilion);
}
.tpl-ink-jade .lede{
  font-family: var(--serif);
  font-size: 16px; line-height: 1.85;
  color: var(--ink-2);
  font-weight: 400;
  letter-spacing: .04em;
  margin: 16px 0 0;
  max-width: 78ch;
}
.tpl-ink-jade .mt-s{margin-top: 12px}
.tpl-ink-jade .mt-m{margin-top: 22px}
.tpl-ink-jade .mt-l{margin-top: 32px !important}

/* ============== 网格 ============== */
.tpl-ink-jade .grid{display: grid; gap: 20px; margin-top: 24px}
.tpl-ink-jade .g1{grid-template-columns: 1fr}
.tpl-ink-jade .g2{grid-template-columns: 1fr 1fr}
.tpl-ink-jade .g3{grid-template-columns: repeat(3, 1fr)}
.tpl-ink-jade .row{display: flex; align-items: center; gap: 16px}

/* ============== 概念卡（无阴影·黑边·2px 角） ============== */
.tpl-ink-jade .concept-box{
  background: transparent;
  border: 1px solid var(--ink-border);
  border-radius: 2px;
  padding: 24px 28px;
  position: relative;
  transition: border-color .3s ease;
}
.tpl-ink-jade .concept-box:hover{ border-color: var(--vermilion); }

.tpl-ink-jade .concept-box h4{
  font-family: var(--serif);
  font-size: 21px; font-weight: 600;
  color: var(--ink);
  margin: 8px 0 4px;
  letter-spacing: .08em;
}
.tpl-ink-jade .concept-box h4 .acc{
  color: var(--vermilion);
  font-family: var(--kai);
  font-weight: 400;
  font-size: 24px;
  letter-spacing: .12em;
  margin-right: 2px;
}
.tpl-ink-jade .concept-box .en{
  display: block;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: .22em;
  color: var(--ink-3);
  text-transform: uppercase;
  margin-bottom: 8px;
}
.tpl-ink-jade .concept-box .dim{
  font-family: var(--serif);
  font-size: 14px;
  color: var(--ink-2);
  line-height: 1.78;
  letter-spacing: .03em;
}
.tpl-ink-jade .concept-box .dim strong{
  color: var(--vermilion);
  font-weight: 600;
}
.tpl-ink-jade .concept-box .no{
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: .2em;
  font-weight: 600;
  color: var(--vermilion);
}

/* ============== 印章 / 朱红 brush ============== */
.tpl-ink-jade .seal{
  display: inline-block;
  background: var(--vermilion);
  color: var(--seal-ink);
  font-family: var(--kai);
  font-size: 14px; font-weight: 400;
  padding: 4px 9px;
  letter-spacing: .1em;
  transform: rotate(-3deg);
  border: 1.5px solid var(--vermilion);
  white-space: nowrap;
  line-height: 1;
}
.tpl-ink-jade .seal.lg{
  font-size: 20px;
  padding: 10px 14px;
  letter-spacing: .14em;
}
.tpl-ink-jade .seal::before{
  content:'';
  display: inline-block;
  width: 3px; height: 3px;
  background: var(--seal-ink);
  border-radius: 50%;
  margin-right: 6px;
  vertical-align: middle;
  opacity: .55;
}

/* ============== 数字 (metric) ============== */
.tpl-ink-jade .metric{
  background: transparent;
  border: none;
  border-bottom: 1px solid var(--ink-border);
  border-radius: 0;
  padding: 8px 0 18px;
  display: flex; flex-direction: column; gap: 8px;
}
.tpl-ink-jade .metric .n{
  font-family: var(--mono);
  font-size: 56px; font-weight: 600;
  line-height: 1;
  letter-spacing: -.02em;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.tpl-ink-jade .metric .n .u{
  font-size: 18px; font-weight: 500;
  color: var(--vermilion);
  margin-left: 4px;
  letter-spacing: 0;
}
.tpl-ink-jade .metric .l{
  font-family: var(--serif);
  font-size: 14px; color: var(--ink-2);
  line-height: 1.6;
  letter-spacing: .04em;
}
.tpl-ink-jade .metric .cite{
  font-family: var(--mono);
  font-size: 10px; letter-spacing: .14em;
  color: var(--ink-3);
  display: block; margin-top: 2px;
}
.tpl-ink-jade .metric.revenue{
  border-top: 1.5px solid var(--vermilion);
  border-bottom: 1.5px solid var(--ink);
  padding: 14px 0;
}
.tpl-ink-jade .metric.revenue .lbl{
  font-family: var(--mono);
  font-size: 10px; letter-spacing: .2em;
  color: var(--vermilion);
  font-weight: 600;
  text-transform: uppercase;
}
.tpl-ink-jade .metric.revenue .formula{
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-3);
  letter-spacing: .04em;
}
.tpl-ink-jade .metric-total{
  text-align: center;
  padding: 18px 0 0;
  border-top: 1px solid var(--ink-border-strong);
}
.tpl-ink-jade .metric-total .big{
  font-family: var(--serif);
  font-size: 60px; font-weight: 700;
  letter-spacing: .04em;
  color: var(--vermilion);
  font-variant-numeric: tabular-nums;
}
.tpl-ink-jade .metric-total .dim{
  font-family: var(--mono);
  font-size: 11px; letter-spacing: .18em;
  color: var(--ink-3);
  display: block; margin-top: 4px;
}

/* ============== 人物画像 ============== */
.tpl-ink-jade .persona{padding: 28px 32px}
.tpl-ink-jade .persona .tag{
  font-family: var(--mono);
  font-size: 11px; letter-spacing: .2em;
  color: var(--vermilion);
  font-weight: 600;
}
.tpl-ink-jade .persona .age{
  float: right;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-3);
  letter-spacing: .12em;
}
.tpl-ink-jade .persona .name{
  font-family: var(--kai);
  font-size: 52px; font-weight: 400;
  line-height: 1;
  color: var(--ink);
  margin: 10px 0 4px;
  letter-spacing: .12em;
}
.tpl-ink-jade .persona .role{
  font-family: var(--serif);
  font-size: 14px; color: var(--ink-2);
  margin: 6px 0 12px;
  letter-spacing: .04em;
}
.tpl-ink-jade .num-row{
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  padding: 14px 0;
  border-top: 1px solid var(--ink-border);
  border-bottom: 1px solid var(--ink-border);
  margin: 12px 0;
}
.tpl-ink-jade .num-row .lbl{
  font-family: var(--mono);
  font-size: 10px; letter-spacing: .18em;
  color: var(--ink-3);
  text-transform: uppercase;
  display: block; margin-bottom: 4px;
}
.tpl-ink-jade .num-row .val{
  font-family: var(--mono);
  font-size: 26px; font-weight: 600;
  color: var(--ink);
  letter-spacing: -.01em;
  font-variant-numeric: tabular-nums;
}
.tpl-ink-jade .num-row .val.muted{color: var(--ink-3); font-weight: 500}
.tpl-ink-jade .num-row .u{
  font-size: 12px; color: var(--ink-3);
  margin-left: 4px;
}
.tpl-ink-jade .persona .sub{
  font-family: var(--serif);
  font-size: 13px; color: var(--ink-2);
  margin: 8px 0;
  letter-spacing: .04em;
  line-height: 1.7;
}
.tpl-ink-jade .pain{
  padding-top: 12px;
  border-top: 1px dashed var(--ink-border);
  margin-top: 10px;
  font-family: var(--serif);
  font-size: 13px; color: var(--ink);
  line-height: 1.78;
  letter-spacing: .04em;
}
.tpl-ink-jade .pain-label{
  font-family: var(--mono);
  font-size: 10px; letter-spacing: .2em;
  color: var(--vermilion);
  font-weight: 600;
  text-transform: uppercase;
  display: block; margin-bottom: 4px;
}

/* ============== Module / Phase / Inno ============== */
.tpl-ink-jade .module{padding: 24px 28px}
.tpl-ink-jade .module h4{
  font-family: var(--kai);
  font-size: 32px; font-weight: 400;
  color: var(--ink);
  margin: 6px 0 4px;
  letter-spacing: .1em;
}
.tpl-ink-jade .phase{padding: 26px 28px}
.tpl-ink-jade .phase .yr{
  font-family: var(--mono);
  font-size: 32px; font-weight: 600;
  color: var(--vermilion);
  line-height: 1;
  display: block;
  margin-bottom: 4px;
  letter-spacing: .04em;
}
.tpl-ink-jade .phase h4{
  font-family: var(--serif);
  font-size: 24px; font-weight: 600;
  margin: 4px 0 4px;
  letter-spacing: .08em;
}
.tpl-ink-jade .inno{
  display: grid;
  grid-template-columns: 50px 1fr;
  gap: 18px;
  padding: 18px 24px;
  align-items: start;
}
.tpl-ink-jade .inno h4{
  font-size: 17px !important;
  margin: 0 0 2px !important;
}
.tpl-ink-jade .inno .en{ font-size: 9px !important; }

/* SWOT border-left */
.tpl-ink-jade .concept-box.s,
.tpl-ink-jade .concept-box.w,
.tpl-ink-jade .concept-box.o,
.tpl-ink-jade .concept-box.t{
  border-left: 2px solid var(--vermilion);
}

/* ul.l */
.tpl-ink-jade .concept-box ul.l{
  list-style: none;
  padding: 0; margin: 10px 0 0;
}
.tpl-ink-jade .concept-box ul.l li{
  font-family: var(--serif);
  font-size: 13px; color: var(--ink);
  line-height: 1.7;
  padding: 5px 0 5px 16px;
  position: relative;
  border-bottom: 1px dashed var(--ink-border);
  letter-spacing: .03em;
}
.tpl-ink-jade .concept-box ul.l li:last-child{ border-bottom: none }
.tpl-ink-jade .concept-box ul.l li::before{
  content:'·';
  position: absolute; left: 2px; top: 5px;
  color: var(--vermilion);
  font-weight: 700;
  font-size: 18px;
  line-height: 1;
}

/* ============== Callout (引文) ============== */
.tpl-ink-jade .callout{
  border: none;
  background: var(--paper-deep);
  border-left: 2px solid var(--vermilion);
  padding: 14px 20px;
  border-radius: 0;
  margin-top: 22px;
  font-family: var(--serif);
  font-size: 14.5px;
  color: var(--ink);
  line-height: 1.8;
  letter-spacing: .04em;
  position: relative;
}
.tpl-ink-jade .callout b{
  color: var(--vermilion);
  font-weight: 600;
  font-family: var(--kai);
  font-size: 16px;
  letter-spacing: .08em;
  margin-right: 4px;
}

/* ============== Pill ============== */
.tpl-ink-jade .pill-academic{
  display: inline-block;
  padding: 4px 12px;
  border: 1px solid var(--ink-border);
  border-radius: 0;
  background: transparent;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-2);
  letter-spacing: .12em;
  margin-right: 8px;
}

/* ============== Rows (sc / tech / risk) ============== */
.tpl-ink-jade .row.sc{
  display: grid;
  grid-template-columns: 60px 1.2fr 1.4fr 180px;
  align-items: center;
  gap: 20px;
  padding: 14px 20px;
  border: 1px solid var(--ink-border);
  border-radius: 0;
  background: transparent;
  margin-bottom: -1px;
  min-height: 60px;
  transition: background .2s ease;
}
.tpl-ink-jade .row.sc:hover{ background: var(--vermilion-faint); }
.tpl-ink-jade .row.sc .no{
  font-family: var(--mono);
  font-size: 15px; font-weight: 600;
  color: var(--vermilion);
  letter-spacing: .1em;
}
.tpl-ink-jade .row.sc .name{
  font-family: var(--serif);
  font-size: 19px; font-weight: 600;
  color: var(--ink);
  letter-spacing: .06em;
}
.tpl-ink-jade .row.sc .brands{
  font-family: var(--serif);
  font-size: 13.5px;
  color: var(--ink-2);
  letter-spacing: .03em;
}
.tpl-ink-jade .row.sc .stat{
  font-family: var(--mono);
  font-size: 13.5px; letter-spacing: .04em;
  color: var(--ink);
  font-weight: 600;
  text-align: right;
}

.tpl-ink-jade .row.tech{
  display: grid;
  grid-template-columns: 60px 1.3fr 100px 2fr;
  align-items: center;
  gap: 20px;
  padding: 14px 20px;
  border: 1px solid var(--ink-border);
  border-radius: 0;
  margin-bottom: -1px;
  min-height: 60px;
}
.tpl-ink-jade .row.tech.primary{
  background: var(--paper-deep);
  border-left: 3px solid var(--vermilion);
  padding-left: 18px;
}
.tpl-ink-jade .row.tech.future{ opacity: .5 }
.tpl-ink-jade .row.tech .no{
  font-family: var(--mono);
  font-size: 20px; font-weight: 700;
  color: var(--vermilion);
}
.tpl-ink-jade .row.tech .name{
  font-family: var(--serif);
  font-size: 19px; font-weight: 600;
  color: var(--ink);
  letter-spacing: .06em;
}
.tpl-ink-jade .row.tech .pct{
  font-family: var(--mono);
  font-size: 15px; font-weight: 600;
  color: var(--vermilion);
  text-align: right;
}
.tpl-ink-jade .row.tech .body{
  font-family: var(--serif);
  font-size: 14px; color: var(--ink-2);
  line-height: 1.65;
  letter-spacing: .03em;
}

.tpl-ink-jade .row.risk{
  display: grid;
  grid-template-columns: 50px 1fr;
  align-items: center;
  gap: 20px;
  padding: 12px 20px;
  border: 1px solid var(--ink-border);
  border-radius: 0;
  margin-bottom: -1px;
  min-height: 56px;
}
.tpl-ink-jade .row.risk .no{
  font-family: var(--kai);
  font-size: 22px; font-weight: 400;
  color: var(--vermilion);
  text-align: center;
}
.tpl-ink-jade .row.risk .body{
  font-family: var(--serif);
  font-size: 14px; color: var(--ink);
  line-height: 1.7;
  letter-spacing: .03em;
}
.tpl-ink-jade .row.risk .body b{
  color: var(--vermilion);
  font-weight: 600;
}

/* ============== 痛点矩阵 ============== */
.tpl-ink-jade .matrix-block{
  background: transparent;
  border: 1px solid var(--ink-border-strong);
  border-radius: 2px;
  padding: 22px 26px;
  position: relative;
}
.tpl-ink-jade .matrix-grid{
  display: grid;
  grid-template-columns: 80px repeat(3, 1fr);
  grid-template-rows: 36px repeat(3, 132px) 36px;
  gap: 0;
  height: auto;
}
.tpl-ink-jade .m-corner{grid-row: 1; grid-column: 1}
.tpl-ink-jade .m-axis-top{
  grid-row: 1; grid-column: 2 / 5;
  font-family: var(--mono);
  font-size: 11px; letter-spacing: .2em;
  font-weight: 500;
  color: var(--vermilion);
  text-align: right;
  padding: 0 12px 8px;
}
.tpl-ink-jade .m-row-label{
  font-family: var(--mono);
  font-size: 11px; letter-spacing: .2em;
  color: var(--vermilion);
  font-weight: 500;
  display: flex;
  align-items: center; justify-content: flex-end;
  padding-right: 12px;
}
.tpl-ink-jade .m-cell{
  padding: 14px 16px;
  border: 1px solid var(--ink-border);
  margin: -.5px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  position: relative;
  background: var(--paper);
}
.tpl-ink-jade .m-cell .t{
  font-family: var(--mono);
  font-size: 11px; letter-spacing: .18em;
  font-weight: 600;
  color: var(--vermilion);
  display: inline-block;
  align-self: flex-start;
}
.tpl-ink-jade .m-cell .n{
  font-family: var(--serif);
  font-size: 16px; font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
  margin: 4px 0 2px;
  letter-spacing: .04em;
}
.tpl-ink-jade .m-cell .d{
  font-family: var(--serif);
  font-size: 12.5px;
  color: var(--ink-2);
  line-height: 1.5;
  letter-spacing: .03em;
}
.tpl-ink-jade .m-cell .f{
  font-family: var(--mono);
  font-size: 10px; letter-spacing: .04em;
  color: var(--ink-3);
  margin-top: auto;
  padding-top: 4px;
  border-top: 1px dashed var(--ink-border);
}
.tpl-ink-jade .m-cell.hi{
  background: var(--vermilion);
  border-color: var(--vermilion);
}
.tpl-ink-jade .m-cell.hi .t,
.tpl-ink-jade .m-cell.hi .n,
.tpl-ink-jade .m-cell.hi .d,
.tpl-ink-jade .m-cell.hi .f{
  color: var(--seal-ink);
}
.tpl-ink-jade .m-cell.hi .t{
  background: rgba(255,248,231,.18);
  padding: 2px 6px;
  letter-spacing: .18em;
}
.tpl-ink-jade .m-cell.hi .f{
  border-top-color: rgba(255,248,231,.35);
}
.tpl-ink-jade .m-cell.mid{
  background: var(--paper-deep);
}
.tpl-ink-jade .m-cell.low{ background: var(--paper-soft); opacity: .8 }

.tpl-ink-jade .matrix-axis{
  display: flex;
  justify-content: space-between;
  font-family: var(--mono);
  font-size: 11px; letter-spacing: .14em;
  color: var(--ink-3);
  margin-top: 12px;
  padding: 0 8px;
}
.tpl-ink-jade .matrix-axis .ax-mid{
  color: var(--vermilion);
  font-weight: 600;
}

/* ============== Figure Block (图片) ============== */
.tpl-ink-jade .figure-block{
  margin: 20px 0;
  display: block;
  width: 100%;
  max-width: 100%;
  max-height: 540px;
  overflow: hidden;
}
.tpl-ink-jade .figure-block img{
  display: block;
  width: 100%;
  height: auto;
  max-height: 540px;
  object-fit: contain;
  background: var(--paper-deep);
  border: 1px solid var(--ink);
  border-radius: 0;
  box-shadow: none;
}
.tpl-ink-jade .figure-block figcaption{
  font-family: var(--mono);
  font-size: 11px; letter-spacing: .16em;
  color: var(--ink-3);
  text-transform: uppercase;
  padding: 8px 0 0;
  border-top: 1px solid var(--ink-border);
  margin-top: 8px;
}

/* ============== TOC (目录页) ============== */
.tpl-ink-jade .toc-grid{
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-top: 32px;
}
.tpl-ink-jade .toc-card{
  background: transparent;
  border: 1px solid var(--ink-border);
  border-radius: 2px;
  padding: 28px 32px;
  position: relative;
  min-height: 170px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.tpl-ink-jade .toc-card:hover{ border-color: var(--vermilion); }
.tpl-ink-jade .toc-num{
  font-family: var(--kai);
  font-size: 56px;
  font-weight: 400;
  color: var(--vermilion);
  line-height: 1;
  letter-spacing: .08em;
}
.tpl-ink-jade .toc-card h4{
  font-family: var(--serif);
  font-size: 28px;
  font-weight: 600;
  color: var(--ink);
  margin: 8px 0 4px;
  letter-spacing: .1em;
}
.tpl-ink-jade .toc-card .en{
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: .22em;
  color: var(--ink-3);
  text-transform: uppercase;
  display: block;
}
.tpl-ink-jade .toc-card .q{
  font-family: var(--serif);
  font-size: 15px;
  color: var(--ink);
  line-height: 1.75;
  margin: 8px 0 0;
  letter-spacing: .04em;
}
.tpl-ink-jade .toc-card .q strong{
  color: var(--vermilion);
  font-weight: 600;
  font-family: var(--kai);
  font-size: 17px;
  letter-spacing: .08em;
}
.tpl-ink-jade .toc-card .hint{
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: .1em;
  color: var(--ink-3);
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px dashed var(--ink-border);
}

/* ============== SWOT 布局 ============== */
.tpl-ink-jade .swot-layout{
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 32px;
  align-items: start;
}
.tpl-ink-jade .swot-grid{
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
.tpl-ink-jade .swot-grid .concept-box{ padding: 22px 24px }
.tpl-ink-jade .swot-grid .concept-box h4{ font-size: 21px; margin-bottom: 6px }
.tpl-ink-jade .swot-grid .concept-box .en{ font-size: 10px; margin-bottom: 8px }
.tpl-ink-jade .swot-grid .concept-box ul.l{ font-size: 13px; line-height: 1.7 }
.tpl-ink-jade .swot-grid .concept-box ul.l li{ margin-bottom: 6px }
.tpl-ink-jade .swot-fig{ margin: 0; position: sticky; top: 16px }
.tpl-ink-jade .swot-fig img{
  width: 100%; height: auto;
  border: 1px solid var(--ink);
  border-radius: 0;
  box-shadow: none;
}
.tpl-ink-jade .swot-fig figcaption{
  font-family: var(--mono);
  font-size: 10px;
  color: var(--ink-3);
  margin-top: 10px;
  text-align: left;
  letter-spacing: .16em;
  text-transform: uppercase;
  padding-top: 8px;
  border-top: 1px solid var(--ink-border);
}

/* ============== 原型页 3 张图 ============== */
.tpl-ink-jade .grid.g3{
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

/* ============== 页脚 / 页码 ============== */
.tpl-ink-jade .deck-footer{
  position: absolute;
  bottom: 20px;
  left: 80px; right: 80px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: .16em;
  color: var(--ink-3);
}
.tpl-ink-jade .deck-footer .slide-number::before{
  content: '— ' attr(data-current) ' / ' attr(data-total) ' —';
  color: var(--vermilion);
  font-weight: 600;
  letter-spacing: .22em;
}
.tpl-ink-jade .deck-footer .author{
  color: var(--ink-3);
  letter-spacing: .14em;
}

/* ============== Cover 中心排版 ============== */
.tpl-ink-jade .slide.full .h1{ font-size: 96px; }
.tpl-ink-jade .slide.full .lede{
  text-align: center;
  max-width: 60ch;
  margin: 24px auto 0;
}
.tpl-ink-jade .cover-center{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  width: 100%;
  height: 100%;
}
.tpl-ink-jade .cover-center .kicker{ margin-bottom: 8px }
.tpl-ink-jade .cover-center .h1{
  font-size: 110px;
  letter-spacing: .08em;
  line-height: 1.05;
  margin: 8px 0 0;
}
.tpl-ink-jade .cover-center .lede{
  margin: 28px auto 0;
  max-width: 56ch;
  text-align: center;
}
.tpl-ink-jade .cover-meta{
  margin-top: 56px;
  display: flex;
  justify-content: center;
  gap: 0;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: .18em;
  color: var(--ink-3);
}
.tpl-ink-jade .cover-meta .meta-item{
  padding: 0 24px;
  border-left: 1px solid var(--ink-border);
  text-align: center;
}
.tpl-ink-jade .cover-meta .meta-item:first-child{ border-left: none }
.tpl-ink-jade .cover-meta .meta-item b{
  display: block;
  font-family: var(--serif);
  font-size: 13px;
  color: var(--ink);
  font-weight: 600;
  margin-top: 4px;
  letter-spacing: .06em;
}

/* ============== Q&A 页 ============== */
.tpl-ink-jade .qa-title{
  text-align: center;
  margin: 0 auto;
}
.tpl-ink-jade .qa-pills{
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin-top: 32px;
  max-width: 90%;
  margin-left: auto; margin-right: auto;
}
.tpl-ink-jade .qa-pill{
  display: inline-block;
  padding: 6px 14px;
  border: 1px solid var(--ink-border);
  font-family: var(--serif);
  font-size: 13px;
  color: var(--ink-2);
  letter-spacing: .04em;
  background: transparent;
}
.tpl-ink-jade .qa-pill::before{
  content:'问 ';
  color: var(--vermilion);
  font-family: var(--kai);
  font-weight: 400;
  margin-right: 4px;
}

/* ============== code ============== */
.tpl-ink-jade code{
  font-family: var(--mono);
  font-size: 12px;
  background: var(--paper-deep);
  padding: 2px 6px;
  border-radius: 0;
  color: var(--vermilion);
  border: 1px solid var(--ink-border);
}
