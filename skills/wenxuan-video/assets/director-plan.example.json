{
  "brief": {
    "title": "消息如何经过节点接力（格式示例）",
    "question": "一次任务的消息如何到达结果？",
    "answer": "节点按确定流程传递，局部接力构成整体流程；这是示意模型。",
    "throughline": "同一枚消息光点",
    "audience": "第一次接触流程图的观众",
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "duration": 12,
    "timingBasis": "estimated",
    "rhythmMode": "music-driven"
  },
  "narrative": {
    "openingPromise": "跟着一枚消息，看清局部动作如何形成整体流程。",
    "closingPayoff": "回到全局，观众能指出消息从起点到结果的路径。",
    "beats": [
      {
        "id": "question",
        "newInformation": "建立一个消息和三个节点。"
      },
      {
        "id": "relay",
        "newInformation": "节点之间按顺序传递，而不是全体同时发光。"
      },
      {
        "id": "system",
        "newInformation": "局部动作属于同一条完整链路。"
      }
    ]
  },
  "review": {
    "storyboard": "checked",
