        "endView": "第三个节点局部",
        "startAt": 0.3,
        "endAt": 3.8
      },
      "transition": {
        "kind": "match-anchor",
        "carry": "第三节点保持位置，作为拉远镜头的锚点"
      },
      "musicCue": {
        "segmentIds": [
          "phrase"
        ],
        "targetEventId": "E2",
        "visualHit": "消息抵达下一节点"
      }
    },
    {
      "id": "S3",
      "beatId": "system",
      "start": 8,
      "end": 12,
      "purpose": "揭示完整流程并回答开头。",
      "startState": "消息停在第三节点，局部景别",
      "endState": "全流程可见，消息停在结果端",
      "composition": "拉远显示完整纵向网络，减少次要标签保留三站顺序",
      "voice": "拉远看，这些局部动作，连成了同一条流程。",
      "caption": "局部接力，组成整体。",
      "camera": {
        "kind": "pull",
        "motivation": "从刚才局部动作揭示全局关系",
        "startView": "第三节点近景",
        "endView": "完整三节点流程",
        "startAt": 0,
        "endAt": 1.4
      },
      "transition": {
        "kind": "hold-and-end",
        "carry": "停留读取完整链路后结束，不另起新信息"
