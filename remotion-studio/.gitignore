# Dependencies and build caches
/node_modules/
/dist/
/out/
/.cache/
/.remotion/
*.tsbuildinfo

# Local configuration
.DS_Store
.env
.env.*
!.env.example

# Rendered media and visual inspection outputs
/renders/
/evidence/**/*.png
/evidence/**/*.jpg
/evidence/**/*.jpeg
/evidence/**/*.mp4
/evidence/**/*.mov
/evidence/studio-drag-before-reset.tsx

# Override the parent archive rule: these are required video inputs.
!/data/
!/data/**

# Local rollback snapshots and duplicate source exports
/evidence/astra-baseline/
/evidence/**/MODIFIED_FILE
/evidence/**/DIFF_FILE
/evidence/**/ROLLBACK.sh
/evidence/**/VERIFICATION.txt

# Generated inspection reports, frame manifests, GIFs and rollback snapshots.
# Ignore every evidence entry, but retain the third-party license.
/evidence/*
!/evidence/MAGIC_UI_LICENSE.txt

# Root-level transaction exports are local evidence, not application source.
/MODIFIED_FILE
/DIFF_FILE
/DIFF_FILE.patch
/VERIFICATION.txt
/ROLLBACK.sh

# Local source downloads and rendered media; keep asset manifests and logos.
*.webm
*.mov
*.mkv
*.mp3
*.wav
/public/talking-head/source.*
