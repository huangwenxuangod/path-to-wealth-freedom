[
 {
  "i": 1,
  "start": 0.139,
  "end": 1.148,
  "text": "如果你想让普通AI"
 },
 {
  "i": 2,
  "start": 1.252,
  "end": 2.157,
  "text": "帮你整理一下桌面"
 },
 {
  "i": 3,
  "start": 2.261,
  "end": 3.374,
  "text": "它可能上来就是一句"
 },
 {
  "i": 4,
  "start": 3.73,
  "end": 6.85,
  "text": "我用最直白最通俗的方式告诉你"
 },
 {
  "i": 5,
  "start": 7.409,
  "end": 8.557,
  "text": "不是啊方法我知道"
 },
 {
  "i": 6,
  "start": 8.557,
  "end": 9.67,
  "text": "你能不能直接帮我弄"
 },
 {
  "i": 7,
  "start": 10.072,
  "end": 10.942,
  "text": "其实普通的AI"
 },
 {
  "i": 8,
  "start": 10.976,
  "end": 12.646,
  "text": "就只能停留在对话的层面"
 },
 {
  "i": 9,
  "start": 12.889,
  "end": 15.22,
  "text": "如果我们真的想让它帮我们干活的话"
 },
 {
  "i": 10,
  "start": 15.429,
  "end": 17.342,
  "text": "我们就必须要让Agent来才行"
 },
 {
  "i": 11,
  "start": 17.829,
  "end": 19.289,
  "text": "那么到底什么是Agent呢"
 },
 {
  "i": 12,
  "start": 20.098,
  "end": 21.837,
  "text": "它又是如何从陪你聊天"
 },
 {
  "i": 13,
  "start": 21.942,
  "end": 23.716,
  "text": "到能够操作你的电脑的"
 },
 {
  "i": 14,
  "start": 23.959,
  "end": 25.559,
  "text": "今天我们就拿整理桌面这件事"
 },
 {
  "i": 15,
  "start": 25.663,
  "end": 28.342,
  "text": "来好好看一下Agent是如何工作的"
 },
 {
  "i": 16,
  "start": 28.603,
  "end": 30.203,
  "text": "假设你桌面上现在有好几个"
 },
 {
  "i": 17,
  "start": 30.203,
  "end": 31.455,
  "text": "之前遗留下来的文件"
 },
 {
  "i": 18,
  "start": 32.046,
  "end": 34.481,
  "text": "名字分别是学习资料.mp4"
 },
 {
  "i": 19,
  "start": 35.037,
  "end": 36.429,
  "text": "学习资料二.mp4"
 },
 {
  "i": 20,
  "start": 36.533,
  "end": 38.689,
  "text": "还有一个学习资料三.mp4"
 },
 {
  "i": 21,
  "start": 39.107,
  "end": 41.124,
  "text": "现在你想把它们按照项目整理好"
 },
 {
  "i": 22,
  "start": 41.333,
  "end": 43.003,
  "text": "顺便找出一些重复的文件"
 },
 {
  "i": 23,
  "start": 43.698,
  "end": 46.063,
  "text": "如果模型只有聊天能力"
 },
 {
  "i": 24,
  "start": 46.098,
  "end": 48.568,
  "text": "那它就只能告诉你该怎么整理"
 },
 {
  "i": 25,
  "start": 49.194,
  "end": 50.376,
  "text": "如果要让它动手"
 },
 {
  "i": 26,
  "start": 50.446,
  "end": 52.742,
  "text": "那我们就得给它先接上工具"
 },
 {
  "i": 27,
  "start": 53.02,
  "end": 54.272,
  "text": "比如说读取文件"
 },
 {
  "i": 28,
  "start": 54.446,
  "end": 56.185,
  "text": "创建文件夹读取视频"
 },
 {
  "i": 29,
  "start": 56.255,
  "end": 57.263,
  "text": "移动文件等等"
 },
 {
  "i": 30,
  "start": 57.985,
  "end": 59.029,
  "text": "不过工具接上了"
 },
 {
  "i": 31,
  "start": 59.029,
  "end": 60.176,
  "text": "你还得告诉它怎么用"
 },
 {
  "i": 32,
  "start": 60.42,
  "end": 62.194,
  "text": "我们得先写个程序"
 },
 {
  "i": 33,
  "start": 62.229,
  "end": 63.724000000000004,
  "text": "来指导模型咋干活"
 },
 {
  "i": 34,
  "start": 64.059,
  "end": 65.832,
  "text": "程序呢会给模型一份说明"
 },
 {
  "i": 35,
  "start": 66.249,
  "end": 67.919,
  "text": "写清楚每个工具能干什么"
 },
 {
  "i": 36,
  "start": 68.023,
  "end": 68.997,
  "text": "需要哪些参数"
 },
 {
  "i": 37,
  "start": 69.623,
  "end": 71.571,
  "text": "这样的话模型看到你的要求"
 },
 {
  "i": 38,
  "start": 71.605,
  "end": 72.82300000000001,
  "text": "就会知道要咋干了"
 },
 {
  "i": 39,
  "start": 73.136,
  "end": 74.945,
  "text": "它会先看一下桌面上有哪些文件"
 },
 {
  "i": 40,
  "start": 75.406,
  "end": 77.319,
  "text": "然后把那些文件的列表拿回来"
 },
 {
  "i": 41,
  "start": 77.852,
  "end": 79.03399999999999,
  "text": "模型拿到列表后呢"
 },
 {
  "i": 42,
  "start": 79.139,
  "end": 81.086,
  "text": "发现这几个文件名字都挺像的"
 },
 {
  "i": 43,
  "start": 81.295,
  "end": 83.069,
  "text": "但光看名字其实也分不拎清"
 },
 {
  "i": 44,
  "start": 83.417,
  "end": 86.582,
  "text": "那它接着就会调用读取视频的这个工具"
 },
 {
  "i": 45,
  "start": 87.086,
  "end": 88.756,
  "text": "看看视频里面到底长啥样"
 },
 {
  "i": 46,
  "start": 89.208,
  "end": 91.678,
  "text": "读完之后呢它才会有依据判断"
 },
 {
  "i": 47,
  "start": 91.712,
  "end": 93.104,
  "text": "哪一些属于同一个项目"
 },
 {
  "i": 48,
  "start": 93.243,
  "end": 94.182,
  "text": "哪一些可能重复"
 },
 {
  "i": 49,
  "start": 94.70400000000001,
  "end": 95.852,
  "text": "然后继续往下走"
 },
 {
  "i": 50,
  "start": 96.131,
  "end": 97.453,
  "text": "你看模型下一步做什么"
 },
 {
  "i": 51,
  "start": 97.453,
  "end": 99.47,
  "text": "是根据上一步拿到的结果决定的"
 },
 {
  "i": 52,
  "start": 99.783,
  "end": 101.10499999999999,
  "text": "外面的程序只不过是"
 },
 {
  "i": 53,
  "start": 101.10499999999999,
  "end": 102.87899999999999,
  "text": "把这个过程接成了一个循环"
 },
 {
  "i": 54,
  "start": 103.47,
  "end": 105.557,
  "text": "然后呢模型就能沿着这个目标"
 },
 {
  "i": 55,
  "start": 105.592,
  "end": 106.357,
  "text": "继续往下做"
 },
 {
  "i": 56,
  "start": 107.062,
  "end": 108.87,
  "text": "不用每走一步都等你说继续"
 },
 {
  "i": 57,
  "start": 109.077,
  "end": 110.538,
  "text": "我们这里讲的AI Agent呢"
 },
 {
  "i": 58,
  "start": 110.57300000000001,
  "end": 111.512,
  "text": "其实就是这样一套"
 },
 {
  "i": 59,
  "start": 111.547,
  "end": 113.14699999999999,
  "text": "能围绕目标调用工具"
 },
 {
  "i": 60,
  "start": 113.59899999999999,
  "end": 116.695,
  "text": "然后根据结果来调整的系统"
 },
 {
  "i": 61,
  "start": 116.922,
  "end": 118.035,
  "text": "但实际整理的时候"
 },
 {
  "i": 62,
  "start": 118.07,
  "end": 119.67,
  "text": "总会碰到一些拿不准的情况"
 },
 {
  "i": 63,
  "start": 120.087,
  "end": 123.565,
  "text": "比如说两份文件都叫学习资料"
 },
 {
  "i": 64,
  "start": 123.838,
  "end": 124.742,
  "text": "内容却不一样"
 },
 {
  "i": 65,
  "start": 124.899,
  "end": 126.151,
  "text": "这时候它就判断不了了"
 },
 {
  "i": 66,
  "start": 126.186,
  "end": 126.916,
  "text": "就需要问你"
 },
 {
  "i": 67,
  "start": 126.951,
  "end": 129.073,
  "text": "而不是自己随便选一份就把它删掉了"
 },
 {
  "i": 68,
  "start": 130.525,
  "end": 132.403,
  "text": "如果工具调用报错了"
 },
 {
  "i": 69,
  "start": 132.473,
  "end": 134.49,
  "text": "程序也会把这个错误给它拿回来"
 },
 {
  "i": 70,
  "start": 134.725,
  "end": 136.186,
  "text": "然后模型会根据这个报错"
 },
 {
  "i": 71,
  "start": 136.255,
  "end": 137.438,
  "text": "调整自己的方法"
 },
 {
  "i": 72,
  "start": 137.855,
  "end": 139.768,
  "text": "不过调整了几次还是不行的话"
 },
 {
  "i": 73,
  "start": 140.11599999999999,
  "end": 141.055,
  "text": "它就得停下来"
 },
 {
  "i": 74,
  "start": 141.194,
  "end": 142.516,
  "text": "而不是一直地试下去"
 },
 {
  "i": 75,
  "start": 143.003,
  "end": 145.534,
  "text": "所以你给Agent的交代任务的时候"
 },
 {
  "i": 76,
  "start": 145.638,
  "end": 146.89,
  "text": "也要把范围说清楚"
 },
 {
  "i": 77,
  "start": 146.994,
  "end": 148.073,
  "text": "哪一些文件可以动"
 },
 {
  "i": 78,
  "start": 148.142,
  "end": 149.394,
  "text": "哪一些文件要先确认"
 },
 {
  "i": 79,
  "start": 149.916,
  "end": 151.69,
  "text": "最多允许它尝试几次等等"
 },
 {
  "i": 80,
  "start": 152.421,
  "end": 153.394,
  "text": "最后整理完了"
 },
 {
  "i": 81,
  "start": 153.534,
  "end": 155.029,
  "text": "它就会把文件放在了哪里"
 },
 {
  "i": 82,
  "start": 155.13400000000001,
  "end": 156.49,
  "text": "哪一些还没有处理清楚"
 },
 {
  "i": 83,
  "start": 156.594,
  "end": 157.29,
  "text": "一起列出来"
 },
 {
  "i": 84,
  "start": 157.647,
  "end": 159.734,
  "text": "这样你打开看一眼就知道它做了什么"
 },
 {
  "i": 85,
  "start": 159.942,
  "end": 161.403,
  "text": "还有哪一些需要你来决定"
 },
 {
  "i": 86,
  "start": 161.804,
  "end": 163.613,
  "text": "OK这就是我们现在非常火的Agent"
 },
 {
  "i": 87,
  "start": 163.787,
  "end": 164.726,
  "text": "现在你理解了吗"
 },
 {
  "i": 88,
  "start": 164.935,
  "end": 166.5,
  "text": "别忘了点赞关注谢谢"
 }
]
