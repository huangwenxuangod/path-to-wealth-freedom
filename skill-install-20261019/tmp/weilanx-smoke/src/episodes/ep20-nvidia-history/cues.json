[
 {
  "i": 1,
  "start": 0.43,
  "end": 1.94,
  "text": "全世界最值钱的公司"
 },
 {
  "i": 2,
  "start": 2.03,
  "end": 4.39,
  "text": "老板每天凌晨 4 点就起来回邮件"
 },
 {
  "i": 3,
  "start": 4.39,
  "end": 5.47,
  "text": "一周干 7 天"
 },
 {
  "i": 4,
  "start": 5.47,
  "end": 8.38,
  "text": "因为他总觉得 公司离倒闭只剩 30 天"
 },
 {
  "i": 5,
  "start": 8.43,
  "end": 9.82,
  "text": "这家公司叫英伟达"
 },
 {
  "i": 6,
  "start": 9.83,
  "end": 11.14,
  "text": "这个老板叫黄仁勋"
 },
 {
  "i": 7,
  "start": 11.44,
  "end": 12.79,
  "text": "去年他上播客时说"
 },
 {
  "i": 8,
  "start": 12.84,
  "end": 14.47,
  "text": "30 天就要倒闭这句话"
 },
 {
  "i": 9,
  "start": 14.48,
  "end": 15.91,
  "text": "他已经说了 33 年"
 },
 {
  "i": 10,
  "start": 15.96,
  "end": 18.11,
  "text": "一家市值快到 6 万亿美元的公司"
 },
 {
  "i": 11,
  "start": 18.16,
  "end": 19.64,
  "text": "为什么老板还这么慌呢"
 },
 {
  "i": 12,
  "start": 19.64,
  "end": 21.59,
  "text": "答案就藏在它这 33 年里"
 },
 {
  "i": 13,
  "start": 21.73,
  "end": 24.89,
  "text": "1993 年 30 岁的黄仁勋和两个工程师朋友"
 },
 {
  "i": 14,
  "start": 24.89,
  "end": 27.52,
  "text": "在加州一家丹尼斯餐厅里决定一起创业"
 },
 {
  "i": 15,
  "start": 27.53,
  "end": 29.4,
  "text": "做专门画 3D 画面的芯片"
 },
 {
  "i": 16,
  "start": 29.49,
  "end": 31.25,
  "text": "挑这家店也不是随便挑的"
 },
 {
  "i": 17,
  "start": 31.25,
  "end": 33.73,
  "text": "黄仁勋 15 岁时就在丹尼斯餐厅打工"
 },
 {
  "i": 18,
  "start": 33.73,
  "end": 35.48,
  "text": "洗过盘子 也端过盘子"
 },
 {
  "i": 19,
  "start": 35.71,
  "end": 37.46,
  "text": "他们的第一款芯片叫 NV1"
 },
 {
  "i": 20,
  "start": 37.59,
  "end": 38.94,
  "text": "结果押错了技术路线"
 },
 {
  "i": 21,
  "start": 38.95,
  "end": 41.55,
  "text": "画 3D 的方法跟微软后来定的标准对不上"
 },
 {
  "i": 22,
  "start": 41.55,
  "end": 42.58,
  "text": "卖得一塌糊涂"
 },
 {
  "i": 23,
  "start": 42.63,
  "end": 43.47,
  "text": "更要命的是"
 },
 {
  "i": 24,
  "start": 43.47,
  "end": 46.06,
  "text": "他们给世嘉做的游戏机芯片也做不下去了"
 },
 {
  "i": 25,
  "start": 46.2,
  "end": 47.59,
  "text": "公司裁掉了一大半员工"
 },
 {
  "i": 26,
  "start": 47.64,
  "end": 49.67,
  "text": "账上的钱只够再发一个月工资"
 },
 {
  "i": 27,
  "start": 49.76,
  "end": 51.59,
  "text": "这就是 30 天要倒闭的出处"
 },
 {
  "i": 28,
  "start": 51.68,
  "end": 54.04,
  "text": "黄仁勋飞到日本跟世嘉老实交代"
 },
 {
  "i": 29,
  "start": 54.04,
  "end": 55.32,
  "text": "这颗芯片做不成了"
 },
 {
  "i": 30,
  "start": 55.32,
  "end": 58.27,
  "text": "但英伟达还需要最后那 500 万美元才能活下去"
 },
 {
  "i": 31,
  "start": 58.45,
  "end": 60.52,
  "text": "没想到世嘉把这笔钱改成了投资"
 },
 {
  "i": 32,
  "start": 60.61,
  "end": 61.49,
  "text": "靠着这笔钱"
 },
 {
  "i": 33,
  "start": 61.49,
  "end": 63.85,
  "text": "他们把剩下的一切押在下一颗芯片上"
 },
 {
  "i": 34,
  "start": 63.85,
  "end": 66.13,
  "text": "1997 年推出的 RIVA 128"
 },
 {
  "i": 35,
  "start": 66.13,
  "end": 67.88,
  "text": "四个月就卖出了一百多万颗"
 },
 {
  "i": 36,
  "start": 68.43,
  "end": 70.22,
  "text": "1999 年 英伟达上市"
 },
 {
  "i": 37,
  "start": 70.23,
  "end": 71.95,
  "text": "同一年推出了 GeForce 256"
 },
 {
  "i": 38,
  "start": 71.95,
  "end": 74.27,
  "text": "还给它起了个新名字 叫 GPU"
 },
 {
  "i": 39,
  "start": 74.27,
  "end": 77.27,
  "text": "2006 年 黄仁勋又下了一个大注 叫 CUDA"
 },
 {
  "i": 40,
  "start": 77.27,
  "end": 79.23,
  "text": "让本来只会画游戏画面的显卡"
 },
 {
  "i": 41,
  "start": 79.23,
  "end": 80.7,
  "text": "也能拿来做科学计算"
 },
 {
  "i": 42,
  "start": 80.88,
  "end": 83.07,
  "text": "这件事让每块显卡的成本涨了一大截"
 },
 {
  "i": 43,
  "start": 83.08,
  "end": 84.47,
  "text": "可当时几乎没人用"
 },
 {
  "i": 44,
  "start": 84.48,
  "end": 85.92,
  "text": "华尔街花了差不多 10 年"
 },
 {
  "i": 45,
  "start": 85.92,
  "end": 87.51,
  "text": "才相信这笔钱没白花"
 },
 {
  "i": 46,
  "start": 87.68,
  "end": 89.07,
  "text": "2008 年金融危机"
 },
 {
  "i": 47,
  "start": 89.16,
  "end": 91.47,
  "text": "英伟达的股价从高点跌掉了八成多"
 },
 {
  "i": 48,
  "start": 91.61,
  "end": 93.56,
  "text": "转机来自一个谁也没想到的地方"
 },
 {
  "i": 49,
  "start": 93.69,
  "end": 95.45,
  "text": "2012 年 辛顿的两个学生"
 },
 {
  "i": 50,
  "start": 95.45,
  "end": 97.13,
  "text": "用两块英伟达的游戏显卡"
 },
 {
  "i": 51,
  "start": 97.13,
  "end": 98.56,
  "text": "训练出了一个神经网络"
 },
 {
  "i": 52,
  "start": 98.57,
  "end": 101.12,
  "text": "在图片识别比赛上把对手甩开了一大截"
 },
 {
  "i": 53,
  "start": 101.25,
  "end": 103.28,
  "text": "深度学习从此离不开 GPU"
 },
 {
  "i": 54,
  "start": 103.37,
  "end": 104.37,
  "text": "2016 年 8 月"
 },
 {
  "i": 55,
  "start": 104.37,
  "end": 107.09,
  "text": "黄仁勋亲手把第一台 DGX-1 超级计算机"
 },
 {
  "i": 56,
  "start": 107.09,
  "end": 108.28,
  "text": "送到了一家小公司"
 },
 {
  "i": 57,
  "start": 108.37,
  "end": 110.65,
  "text": "上面写着 献给计算和人类的未来"
 },
 {
  "i": 58,
  "start": 110.65,
  "end": 112.25,
  "text": "这家公司叫 OpenAI"
 },
 {
  "i": 59,
  "start": 112.25,
  "end": 113.84,
  "text": "当然也不是一路顺风"
 },
 {
  "i": 60,
  "start": 113.89,
  "end": 116.56,
  "text": "2018 年挖矿热退潮 显卡卖不出去"
 },
 {
  "i": 61,
  "start": 116.61,
  "end": 118.88,
  "text": "英伟达的股价两个多月就跌掉了一半多"
 },
 {
  "i": 62,
  "start": 119.02000000000001,
  "end": 122.05,
  "text": "真正的爆发是在 2022 年底 ChatGPT 上线之后"
 },
 {
  "i": 63,
  "start": 122.1,
  "end": 124.93,
  "text": "全世界都在抢着买英伟达的芯片来训练大模型"
 },
 {
  "i": 64,
  "start": 125.02,
  "end": 127.01,
  "text": "那时候它的市值大约 4000 亿美元"
 },
 {
  "i": 65,
  "start": 127.02,
  "end": 128.77,
  "text": "2023 年就突破了一万亿"
 },
 {
  "i": 66,
  "start": 128.78,
  "end": 129.86,
  "text": "2025 年 10 月"
 },
 {
  "i": 67,
  "start": 129.86,
  "end": 132.57,
  "text": "成了人类历史上第一家市值 5 万亿美元的公司"
 },
 {
  "i": 68,
  "start": 132.87,
  "end": 133.67,
  "text": "就在这个月"
 },
 {
  "i": 69,
  "start": 133.67,
  "end": 135.83,
  "text": "它的市值一度摸到了 5.8 万亿美元"
 },
 {
  "i": 70,
  "start": 135.83,
  "end": 137.18,
  "text": "离 6 万亿只差一步"
 },
 {
  "i": 71,
  "start": 137.27,
  "end": 139.62,
  "text": "从一个月的工资 到快 6 万亿的市值"
 },
 {
  "i": 72,
  "start": 139.67000000000002,
  "end": 141.26,
  "text": "英伟达差点死过好几回"
 },
 {
  "i": 73,
  "start": 141.31,
  "end": 143.74,
  "text": "每一回都是押对了下一个大注才活了下来"
 },
 {
  "i": 74,
  "start": 143.91,
  "end": 145.59,
  "text": "所以黄仁勋到今天还在说"
 },
 {
  "i": 75,
  "start": 145.59,
  "end": 147.23,
  "text": "公司离倒闭只剩 30 天"
 },
 {
  "i": 76,
  "start": 147.23,
  "end": 148.15,
  "text": "因为对他来说"
 },
 {
  "i": 77,
  "start": 148.15,
  "end": 149.35,
  "text": "下一个大注押错了"
 },
 {
  "i": 78,
  "start": 149.35,
  "end": 150.75,
  "text": "这句话随时可能成真"
 },
 {
  "i": 79,
  "start": 150.75,
  "end": 152.63,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 80,
  "start": 152.63,
  "end": 153.62,
  "text": "我们下期再见"
 }
]
