[
 {
  "i": 1,
  "start": 0.37,
  "end": 2.24,
  "text": "你的左手和右手长得一模一样"
 },
 {
  "i": 2,
  "start": 2.25,
  "end": 3.84,
  "text": "可你永远没法把左手"
 },
 {
  "i": 3,
  "start": 3.85,
  "end": 5.64,
  "text": "塞进右手的手套里 对吧"
 },
 {
  "i": 4,
  "start": 5.73,
  "end": 6.96,
  "text": "很多分子也是这样"
 },
 {
  "i": 5,
  "start": 6.97,
  "end": 8.76,
  "text": "长得一样 却分左右手"
 },
 {
  "i": 6,
  "start": 8.85,
  "end": 10.25,
  "text": "上世纪 60 年代初"
 },
 {
  "i": 7,
  "start": 10.25,
  "end": 11.81,
  "text": "一种叫反应停的镇静药"
 },
 {
  "i": 8,
  "start": 11.81,
  "end": 14.24,
  "text": "让成千上万的孩子一出生就带着残疾"
 },
 {
  "i": 9,
  "start": 14.48,
  "end": 15.35,
  "text": "后来人们发现"
 },
 {
  "i": 10,
  "start": 15.36,
  "end": 17.39,
  "text": "惹祸的正是药里那个镜像分子"
 },
 {
  "i": 11,
  "start": 17.44,
  "end": 18.64,
  "text": "今年的诺贝尔化学奖"
 },
 {
  "i": 12,
  "start": 18.64,
  "end": 21.56,
  "text": "就颁给了两位让化学反应学会只做一只手的人"
 },
 {
  "i": 13,
  "start": 21.56,
  "end": 22.4,
  "text": "你可能不知道"
 },
 {
  "i": 14,
  "start": 22.4,
  "end": 24.63,
  "text": "你身体里的氨基酸几乎全是左手的"
 },
 {
  "i": 15,
  "start": 24.71,
  "end": 26.54,
  "text": "可化学家在试管里做这些分子"
 },
 {
  "i": 16,
  "start": 26.55,
  "end": 28.03,
  "text": "左手右手总是一半一半"
 },
 {
  "i": 17,
  "start": 28.03,
  "end": 30.02,
  "text": "那生命是怎么只挑一只手的呢"
 },
 {
  "i": 18,
  "start": 30.31,
  "end": 32.34,
  "text": "今年 95 岁的法国化学家卡冈"
 },
 {
  "i": 19,
  "start": 32.39,
  "end": 34.3,
  "text": "在 1986 年发现了一个怪现象"
 },
 {
  "i": 20,
  "start": 34.43,
  "end": 36.06,
  "text": "催化剂里左右手掺在一起"
 },
 {
  "i": 21,
  "start": 36.07,
  "end": 38.14,
  "text": "做出来的产物反而比催化剂更纯"
 },
 {
  "i": 22,
  "start": 38.31,
  "end": 40.22,
  "text": "日本化学家硖合宪三更进一步"
 },
 {
  "i": 23,
  "start": 40.31,
  "end": 42.46,
  "text": "他找到了一种会自己复制自己的分子"
 },
 {
  "i": 24,
  "start": 42.47,
  "end": 45.23,
  "text": "2003 年 一开始碰巧多出一点点的那只手"
 },
 {
  "i": 25,
  "start": 45.23,
  "end": 47.67,
  "text": "最后占了产物的 99.99%"
 },
 {
  "i": 26,
  "start": 47.67,
  "end": 49.26,
  "text": "更妙的是 重做一遍"
 },
 {
  "i": 27,
  "start": 49.31,
  "end": 50.78,
  "text": "赢的可能就换成另一只手"
 },
 {
  "i": 28,
  "start": 50.92,
  "end": 52.4,
  "text": "你想啊 地球上的生命"
 },
 {
  "i": 29,
  "start": 52.4,
  "end": 54,
  "text": "会不会也是在很久很久以前"
 },
 {
  "i": 30,
  "start": 54,
  "end": 55.36,
  "text": "被这样一个小小的偶然"
 },
 {
  "i": 31,
  "start": 55.36,
  "end": 56.59,
  "text": "定下了用哪只手"
 },
 {
  "i": 32,
  "start": 56.64,
  "end": 57.96,
  "text": "所以这个诺奖奖励的"
 },
 {
  "i": 33,
  "start": 57.96,
  "end": 59.16,
  "text": "不只是更安全的药"
 },
 {
  "i": 34,
  "start": 59.16,
  "end": 60.76,
  "text": "而是人类第一次在试管里"
 },
 {
  "i": 35,
  "start": 60.76,
  "end": 62.55,
  "text": "亲眼看着一只手赢下了全部"
 }
]
