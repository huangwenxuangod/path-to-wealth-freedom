[
 {
  "i": 1,
  "start": 0.44,
  "end": 2.55,
  "text": "同样是让 AI 帮忙写一份周报"
 },
 {
  "i": 2,
  "start": 2.56,
  "end": 3.64,
  "text": "有人拿到的是一堆"
 },
 {
  "i": 3,
  "start": 3.64,
  "end": 5.75,
  "text": "放在谁身上都成立的正确废话"
 },
 {
  "i": 4,
  "start": 5.8,
  "end": 7.24,
  "text": "有人拿到的却改两个字"
 },
 {
  "i": 5,
  "start": 7.24,
  "end": 8.51,
  "text": "就能直接发给老板"
 },
 {
  "i": 6,
  "start": 8.56,
  "end": 10.51,
  "text": "而且他们用的还是同一个 AI"
 },
 {
  "i": 7,
  "start": 10.59,
  "end": 11.98,
  "text": "差别到底出在哪呢"
 },
 {
  "i": 8,
  "start": 12.15,
  "end": 14.26,
  "text": "答案就藏在你发给它的那句话里"
 },
 {
  "i": 9,
  "start": 14.27,
  "end": 15.78,
  "text": "这句话有个专门的名字"
 },
 {
  "i": 10,
  "start": 15.79,
  "end": 18.02,
  "text": "叫做提示词 英文是 Prompt"
 },
 {
  "i": 11,
  "start": 18.11,
  "end": 19.47,
  "text": "你可以把提示词理解成"
 },
 {
  "i": 12,
  "start": 19.47,
  "end": 21.18,
  "text": "一份交给 AI 的任务说明书"
 },
 {
  "i": 13,
  "start": 21.34,
  "end": 22.26,
  "text": "AI 很聪明"
 },
 {
  "i": 14,
  "start": 22.26,
  "end": 24.46,
  "text": "但它就像一个第一天来上班的实习生"
 },
 {
  "i": 15,
  "start": 24.46,
  "end": 25.54,
  "text": "不认识你的老板"
 },
 {
  "i": 16,
  "start": 25.54,
  "end": 26.9,
  "text": "不知道你这周忙了什么"
 },
 {
  "i": 17,
  "start": 26.9,
  "end": 29.21,
  "text": "也不清楚你想要多长、什么风格"
 },
 {
  "i": 18,
  "start": 29.34,
  "end": 31.49,
  "text": "你只丢给它一句帮我写份周报"
 },
 {
  "i": 19,
  "start": 31.54,
  "end": 34.21,
  "text": "它就只能按最常见、最保险的样子去猜"
 },
 {
  "i": 20,
  "start": 34.41,
  "end": 35.92,
  "text": "结果自然是一堆套话"
 },
 {
  "i": 21,
  "start": 36.13,
  "end": 38.13,
  "text": "所以问题往往不在 AI 不够聪明"
 },
 {
  "i": 22,
  "start": 38.13,
  "end": 39.88,
  "text": "而在说明书写得太短了"
 },
 {
  "i": 23,
  "start": 39.93,
  "end": 42.08,
  "text": "那一份好的说明书该写些什么呢"
 },
 {
  "i": 24,
  "start": 42.13,
  "end": 43.56,
  "text": "这里分享三个做法"
 },
 {
  "i": 25,
  "start": 43.73,
  "end": 45.29,
  "text": "第一 说清楚目标"
 },
 {
  "i": 26,
  "start": 45.29,
  "end": 46.93,
  "text": "也就是这东西是给谁看的"
 },
 {
  "i": 27,
  "start": 46.93,
  "end": 48,
  "text": "要拿去干什么"
 },
 {
  "i": 28,
  "start": 48.18,
  "end": 50.02,
  "text": "比如这份周报是发给老板的"
 },
 {
  "i": 29,
  "start": 50.02,
  "end": 52.29,
  "text": "重点是让他看到项目进度和风险"
 },
 {
  "i": 30,
  "start": 52.34,
  "end": 53.34,
  "text": "这样一来它就知道"
 },
 {
  "i": 31,
  "start": 53.34,
  "end": 55.21,
  "text": "该突出什么、该省略什么"
 },
 {
  "i": 32,
  "start": 55.38,
  "end": 57.33,
  "text": "第二 把背景和材料给它"
 },
 {
  "i": 33,
  "start": 57.46,
  "end": 59.77,
  "text": "你这周做了哪些事、卡在了哪里"
 },
 {
  "i": 34,
  "start": 59.78,
  "end": 61.46,
  "text": "哪怕只是几行零散的笔记"
 },
 {
  "i": 35,
  "start": 61.46,
  "end": 62.61,
  "text": "也直接贴进去"
 },
 {
  "i": 36,
  "start": 62.77,
  "end": 64.21,
  "text": "因为它不在你的工作现场"
 },
 {
  "i": 37,
  "start": 64.21,
  "end": 66,
  "text": "你不说它就只能靠猜"
 },
 {
  "i": 38,
  "start": 66.17,
  "end": 68.17,
  "text": "第三 讲明白你想要的样子"
 },
 {
  "i": 39,
  "start": 68.17,
  "end": 71,
  "text": "比如写多少字、分几点、用什么语气"
 },
 {
  "i": 40,
  "start": 71.17,
  "end": 72.33,
  "text": "如果实在说不清楚"
 },
 {
  "i": 41,
  "start": 72.33,
  "end": 74.45,
  "text": "就干脆给它一个你以前写过的例子"
 },
 {
  "i": 42,
  "start": 74.45,
  "end": 75.21000000000001,
  "text": "因为一个例子"
 },
 {
  "i": 43,
  "start": 75.21000000000001,
  "end": 76.92,
  "text": "往往比十句形容词都管用"
 },
 {
  "i": 44,
  "start": 77.16,
  "end": 78.95,
  "text": "所以下次 AI 回答得不满意"
 },
 {
  "i": 45,
  "start": 78.96000000000001,
  "end": 80.44,
  "text": "先别急着换一个 AI"
 },
 {
  "i": 46,
  "start": 80.44,
  "end": 81.76,
  "text": "回头看看自己的说明书"
 },
 {
  "i": 47,
  "start": 81.76,
  "end": 82.99,
  "text": "是不是只写了一句话"
 },
 {
  "i": 48,
  "start": 83.03999999999999,
  "end": 85.76,
  "text": "把目标、背景和要求补上再问一遍"
 },
 {
  "i": 49,
  "start": 85.76,
  "end": 87.47,
  "text": "你会发现它就像换了一个人"
 },
 {
  "i": 50,
  "start": 87.75,
  "end": 89.31,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 51,
  "start": 89.31,
  "end": 90.42,
  "text": "我们下期再见"
 }
]
