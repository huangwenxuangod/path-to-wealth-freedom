[
 {
  "i": 1,
  "start": 0.41,
  "end": 1.6,
  "text": "先考你一个问题"
 },
 {
  "i": 2,
  "start": 1.85,
  "end": 2.97,
  "text": "strawberry 这个单词里"
 },
 {
  "i": 3,
  "start": 2.97,
  "end": 4,
  "text": "有几个字母 r"
 },
 {
  "i": 4,
  "start": 4.29,
  "end": 5.4,
  "text": "答案是三个"
 },
 {
  "i": 5,
  "start": 5.41,
  "end": 7.24,
  "text": "但就是这么简单的一道题"
 },
 {
  "i": 6,
  "start": 7.29,
  "end": 9.13,
  "text": "曾经难倒过一大批 AI"
 },
 {
  "i": 7,
  "start": 9.13,
  "end": 11,
  "text": "很多模型张口就答两个"
 },
 {
  "i": 8,
  "start": 11.16,
  "end": 12.23,
  "text": "这么聪明的 AI"
 },
 {
  "i": 9,
  "start": 12.28,
  "end": 14.11,
  "text": "怎么会连字母都数不清呢"
 },
 {
  "i": 10,
  "start": 14.24,
  "end": 15.27,
  "text": "其实这不怪它"
 },
 {
  "i": 11,
  "start": 15.4,
  "end": 17.15,
  "text": "因为它压根就看不到字母"
 },
 {
  "i": 12,
  "start": 17.56,
  "end": 18.39,
  "text": "哈喽各位"
 },
 {
  "i": 13,
  "start": 18.4,
  "end": 20.04,
  "text": "本期视频我们就来聊聊"
 },
 {
  "i": 14,
  "start": 20.04,
  "end": 21.91,
  "text": "AI 眼里的文字到底长什么样"
 },
 {
  "i": 15,
  "start": 22.1,
  "end": 24.33,
  "text": "答案就藏在一个词里 叫做 token"
 },
 {
  "i": 16,
  "start": 24.62,
  "end": 26.26,
  "text": "大模型在读文字之前"
 },
 {
  "i": 17,
  "start": 26.26,
  "end": 28.73,
  "text": "会先把一句话切成一小块一小块的"
 },
 {
  "i": 18,
  "start": 28.74,
  "end": 30.05,
  "text": "每一块就是一个 token"
 },
 {
  "i": 19,
  "start": 30.3,
  "end": 31.22,
  "text": "比如 strawberry"
 },
 {
  "i": 20,
  "start": 31.22,
  "end": 32.01,
  "text": "在它眼里"
 },
 {
  "i": 21,
  "start": 32.06,
  "end": 33.61,
  "text": "可能就是这样三块积木"
 },
 {
  "i": 22,
  "start": 33.91,
  "end": 35.3,
  "text": "它认的是一整块积木"
 },
 {
  "i": 23,
  "start": 35.39,
  "end": 36.98,
  "text": "看不到积木里面的字母"
 },
 {
  "i": 24,
  "start": 36.99,
  "end": 38.94,
  "text": "所以一数 r 就很容易数错"
 },
 {
  "i": 25,
  "start": 39.07,
  "end": 40.22,
  "text": "中文也是一样"
 },
 {
  "i": 26,
  "start": 40.27,
  "end": 41.74,
  "text": "有时候一个字是一块"
 },
 {
  "i": 27,
  "start": 41.79,
  "end": 43.46,
  "text": "有时候几个字拼成一块"
 },
 {
  "i": 28,
  "start": 43.77,
  "end": 45.09,
  "text": "然后它在回答你的时候"
 },
 {
  "i": 29,
  "start": 45.09,
  "end": 46.8,
  "text": "也是一块一块往外吐的"
 },
 {
  "i": 30,
  "start": 46.89,
  "end": 48.41,
  "text": "每一步它只干一件事"
 },
 {
  "i": 31,
  "start": 48.41,
  "end": 50.12,
  "text": "就是看着前面所有的内容"
 },
 {
  "i": 32,
  "start": 50.17,
  "end": 51.84,
  "text": "猜下一块最可能是什么"
 },
 {
  "i": 33,
  "start": 51.85,
  "end": 53.52,
  "text": "接上之后再去猜下一块"
 },
 {
  "i": 34,
  "start": 53.79,
  "end": 55.02,
  "text": "所以你看到的回答"
 },
 {
  "i": 35,
  "start": 55.03,
  "end": 56.78,
  "text": "才会一个字一个字地往外蹦"
 },
 {
  "i": 36,
  "start": 57.03,
  "end": 57.91,
  "text": "搞懂了这个"
 },
 {
  "i": 37,
  "start": 57.91,
  "end": 59.54,
  "text": "有两件事你就明白了"
 },
 {
  "i": 38,
  "start": 59.63,
  "end": 62.02,
  "text": "第一 AI 为什么按 token 收钱"
 },
 {
  "i": 39,
  "start": 62.11,
  "end": 63.62,
  "text": "因为你发过去的每一块"
 },
 {
  "i": 40,
  "start": 63.71,
  "end": 64.95,
  "text": "它回给你的每一块"
 },
 {
  "i": 41,
  "start": 64.95,
  "end": 66.1,
  "text": "都会记在账上"
 },
 {
  "i": 42,
  "start": 66.44,
  "end": 68.71000000000001,
  "text": "第二 AI 为什么聊久了会失忆"
 },
 {
  "i": 43,
  "start": 68.92,
  "end": 71.27,
  "text": "因为它一次能看的积木是有上限的"
 },
 {
  "i": 44,
  "start": 71.28,
  "end": 73.27,
  "text": "这个上限就叫上下文窗口"
 },
 {
  "i": 45,
  "start": 73.4,
  "end": 75.63,
  "text": "聊得太长 窗口就装不下了"
 },
 {
  "i": 46,
  "start": 75.64,
  "end": 78.31,
  "text": "前面的内容会被压缩 甚至直接丢掉"
 },
 {
  "i": 47,
  "start": 78.67,
  "end": 80.07,
  "text": "所以如果你发现一个对话"
 },
 {
  "i": 48,
  "start": 80.07,
  "end": 82.26,
  "text": "聊着聊着 AI 开始犯迷糊了"
 },
 {
  "i": 49,
  "start": 82.27,
  "end": 84.11,
  "text": "最好的办法就是开个新对话"
 },
 {
  "i": 50,
  "start": 84.11,
  "end": 85.63,
  "text": "把要点重新交代一遍"
 },
 {
  "i": 51,
  "start": 85.63,
  "end": 87.63,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 52,
  "start": 87.63,
  "end": 88.7,
  "text": "我们下期再见"
 }
]
