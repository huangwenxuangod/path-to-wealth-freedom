[
 {
  "i": 1,
  "start": 0.37,
  "end": 1.6,
  "text": "你有没有遇到过这种情况"
 },
 {
  "i": 2,
  "start": 1.61,
  "end": 3.24,
  "text": "让 AI 帮你修一个网页"
 },
 {
  "i": 3,
  "start": 3.25,
  "end": 4.93,
  "text": "它回你一句全部改好了"
 },
 {
  "i": 4,
  "start": 4.93,
  "end": 6.24,
  "text": "所有问题都已经修复"
 },
 {
  "i": 5,
  "start": 6.25,
  "end": 7.17,
  "text": "可你一打开"
 },
 {
  "i": 6,
  "start": 7.17,
  "end": 8.37,
  "text": "页面还是一片空白"
 },
 {
  "i": 7,
  "start": 8.37,
  "end": 9.92,
  "text": "后台全是红色的报错"
 },
 {
  "i": 8,
  "start": 10.05,
  "end": 11.13,
  "text": "它明明说做完了"
 },
 {
  "i": 9,
  "start": 11.13,
  "end": 12.28,
  "text": "怎么就是没做完呢"
 },
 {
  "i": 10,
  "start": 12.44,
  "end": 13.32,
  "text": "这背后的原因"
 },
 {
  "i": 11,
  "start": 13.32,
  "end": 15.55,
  "text": "要从 Agent 是怎么判断做完了说起"
 },
 {
  "i": 12,
  "start": 15.64,
  "end": 16.56,
  "text": "我们之前讲过"
 },
 {
  "i": 13,
  "start": 16.56,
  "end": 18.44,
  "text": "Agent 是在一个循环里干活的"
 },
 {
  "i": 14,
  "start": 18.44,
  "end": 20.99,
  "text": "做一步、看一眼结果、再决定下一步"
 },
 {
  "i": 15,
  "start": 21,
  "end": 22.35,
  "text": "可什么时候该停下来"
 },
 {
  "i": 16,
  "start": 22.36,
  "end": 23.23,
  "text": "它得有个依据"
 },
 {
  "i": 17,
  "start": 23.52,
  "end": 25.39,
  "text": "如果你只说一句帮我修好它"
 },
 {
  "i": 18,
  "start": 25.56,
  "end": 27.11,
  "text": "它手里没有任何检查的标准"
 },
 {
  "i": 19,
  "start": 27.12,
  "end": 28.28,
  "text": "往往就是改完代码"
 },
 {
  "i": 20,
  "start": 28.28,
  "end": 29.64,
  "text": "自己读一遍觉得没问题"
 },
 {
  "i": 21,
  "start": 29.64,
  "end": 30.76,
  "text": "就宣布完工了"
 },
 {
  "i": 22,
  "start": 30.76,
  "end": 32.19,
  "text": "至于真正跑起来行不行"
 },
 {
  "i": 23,
  "start": 32.2,
  "end": 33.27,
  "text": "它压根没看过"
 },
 {
  "i": 24,
  "start": 33.48,
  "end": 34.72,
  "text": "这就像请人来刷墙"
 },
 {
  "i": 25,
  "start": 34.72,
  "end": 35.91,
  "text": "你只说刷好它"
 },
 {
  "i": 26,
  "start": 36,
  "end": 37.31,
  "text": "他刷完转身就走了"
 },
 {
  "i": 27,
  "start": 37.32,
  "end": 39.2,
  "text": "可你要是说刷完之后站远一点"
 },
 {
  "i": 28,
  "start": 39.2,
  "end": 40.59,
  "text": "看看有没有漏刷的地方"
 },
 {
  "i": 29,
  "start": 40.6,
  "end": 41.79,
  "text": "结果就完全不一样"
 },
 {
  "i": 30,
  "start": 41.92,
  "end": 43.96,
  "text": "所以 Agent 能不能真的把活干完"
 },
 {
  "i": 31,
  "start": 43.96,
  "end": 45,
  "text": "很大程度上取决于"
 },
 {
  "i": 32,
  "start": 45,
  "end": 46.31,
  "text": "你有没有给它一把尺子"
 },
 {
  "i": 33,
  "start": 46.4,
  "end": 47.91,
  "text": "那怎么让它真正做完呢"
 },
 {
  "i": 34,
  "start": 47.92,
  "end": 49.27,
  "text": "这里分享三个做法"
 },
 {
  "i": 35,
  "start": 49.48,
  "end": 51.75,
  "text": "第一 先说清楚怎样才算做完"
 },
 {
  "i": 36,
  "start": 51.88,
  "end": 53.52,
  "text": "比如页面能正常打开"
 },
 {
  "i": 37,
  "start": 53.52,
  "end": 54.67,
  "text": "按钮点了有反应"
 },
 {
  "i": 38,
  "start": 54.68,
  "end": 56.04,
  "text": "原来的测试全部通过"
 },
 {
  "i": 39,
  "start": 56.04,
  "end": 57.95,
  "text": "把这些写成一条一条的验收标准"
 },
 {
  "i": 40,
  "start": 58.12,
  "end": 59.75,
  "text": "它就知道要做到哪一步才能停"
 },
 {
  "i": 41,
  "start": 60,
  "end": 62.43,
  "text": "第二 让它自己跑一遍、检查一遍"
 },
 {
  "i": 42,
  "start": 62.6,
  "end": 64.16,
  "text": "干完活别急着让它汇报"
 },
 {
  "i": 43,
  "start": 64.16,
  "end": 65.87,
  "text": "而是要求它亲手运行一下"
 },
 {
  "i": 44,
  "start": 65.88,
  "end": 67.92,
  "text": "打开页面看看、把测试跑一遍"
 },
 {
  "i": 45,
  "start": 67.92,
  "end": 69.52,
  "text": "再把检查的结果拿给你看"
 },
 {
  "i": 46,
  "start": 69.52,
  "end": 70.99,
  "text": "而不是只回你一句好了"
 },
 {
  "i": 47,
  "start": 71.25,
  "end": 73.52,
  "text": "第三 关键的地方你自己抽查一下"
 },
 {
  "i": 48,
  "start": 73.65,
  "end": 74.77,
  "text": "它说测试都过了"
 },
 {
  "i": 49,
  "start": 74.77,
  "end": 77.08,
  "text": "你就随手点开一两个最重要的功能试试"
 },
 {
  "i": 50,
  "start": 77.13,
  "end": 78.17,
  "text": "花一分钟确认"
 },
 {
  "i": 51,
  "start": 78.17,
  "end": 80.76,
  "text": "总比上线之后才发现问题要省心得多"
 },
 {
  "i": 52,
  "start": 81.17,
  "end": 82.69,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 53,
  "start": 82.69,
  "end": 83.68,
  "text": "我们下期再见"
 }
]
