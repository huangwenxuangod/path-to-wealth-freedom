[
 {
  "i": 1,
  "start": 0.43,
  "end": 1.19,
  "text": "去年七月"
 },
 {
  "i": 2,
  "start": 1.19,
  "end": 4.18,
  "text": "一位创业者在用 Replit 的 AI 编程助手做项目"
 },
 {
  "i": 3,
  "start": 4.35,
  "end": 6.19,
  "text": "他已经明确交代过先别动代码"
 },
 {
  "i": 4,
  "start": 6.19,
  "end": 8.27,
  "text": "可这个 AI 还是自己执行了一条命令"
 },
 {
  "i": 5,
  "start": 8.27,
  "end": 9.94,
  "text": "把线上的数据库给删了"
 },
 {
  "i": 6,
  "start": 10.03,
  "end": 12.54,
  "text": "事后 Replit 的 CEO 还公开出来道了歉"
 },
 {
  "i": 7,
  "start": 12.78,
  "end": 14.02,
  "text": "一个帮你干活的 AI"
 },
 {
  "i": 8,
  "start": 14.02,
  "end": 15.57,
  "text": "怎么就闯了这么大的祸呢"
 },
 {
  "i": 9,
  "start": 15.74,
  "end": 16.7,
  "text": "问题就出在一件"
 },
 {
  "i": 10,
  "start": 16.7,
  "end": 18.34,
  "text": "很多人没太在意的事情上"
 },
 {
  "i": 11,
  "start": 18.34,
  "end": 19.89,
  "text": "叫做 Agent 的权限"
 },
 {
  "i": 12,
  "start": 20.06,
  "end": 21.06,
  "text": "我们之前讲过"
 },
 {
  "i": 13,
  "start": 21.06,
  "end": 23.1,
  "text": "Agent 和聊天 AI 最大的区别"
 },
 {
  "i": 14,
  "start": 23.1,
  "end": 24.45,
  "text": "就是它能自己动手"
 },
 {
  "i": 15,
  "start": 24.61,
  "end": 26.69,
  "text": "会读文件、改代码、发消息"
 },
 {
  "i": 16,
  "start": 26.69,
  "end": 28.08,
  "text": "还能接上各种工具"
 },
 {
  "i": 17,
  "start": 28.17,
  "end": 29.25,
  "text": "而权限说的就是"
 },
 {
  "i": 18,
  "start": 29.25,
  "end": 30.68,
  "text": "你交给它哪几把钥匙"
 },
 {
  "i": 19,
  "start": 30.77,
  "end": 32.53,
  "text": "能看、能改、能删"
 },
 {
  "i": 20,
  "start": 32.53,
  "end": 34.04,
  "text": "还是能直接替你花钱"
 },
 {
  "i": 21,
  "start": 34.25,
  "end": 35.28,
  "text": "钥匙给得越多"
 },
 {
  "i": 22,
  "start": 35.29,
  "end": 36.77,
  "text": "它能帮你干的活就越多"
 },
 {
  "i": 23,
  "start": 36.77,
  "end": 38.52,
  "text": "可一旦它理解错了你的意思"
 },
 {
  "i": 24,
  "start": 38.53,
  "end": 39.8,
  "text": "或者自己判断失误"
 },
 {
  "i": 25,
  "start": 39.85,
  "end": 41,
  "text": "闯的祸也就越大"
 },
 {
  "i": 26,
  "start": 41.26,
  "end": 42.58,
  "text": "所以现在很多 Agent 工具"
 },
 {
  "i": 27,
  "start": 42.58,
  "end": 43.81,
  "text": "都有一个确认的机制"
 },
 {
  "i": 28,
  "start": 43.9,
  "end": 45.21,
  "text": "碰到有风险的操作"
 },
 {
  "i": 29,
  "start": 45.26,
  "end": 47.3,
  "text": "它会先停下来问你一句要不要执行"
 },
 {
  "i": 30,
  "start": 47.3,
  "end": 49.05,
  "text": "你点了同意它才会动手"
 },
 {
  "i": 31,
  "start": 49.1,
  "end": 50.42,
  "text": "这一步看起来有点烦"
 },
 {
  "i": 32,
  "start": 50.42,
  "end": 52.14,
  "text": "但它其实就是你和 AI 之间的"
 },
 {
  "i": 33,
  "start": 52.14,
  "end": 53.09,
  "text": "最后一道闸门"
 },
 {
  "i": 34,
  "start": 53.26,
  "end": 54.93,
  "text": "那平时怎么用才放心呢"
 },
 {
  "i": 35,
  "start": 55.02,
  "end": 56.37,
  "text": "这里分享三个建议"
 },
 {
  "i": 36,
  "start": 56.54,
  "end": 58.25,
  "text": "第一 先给最少的钥匙"
 },
 {
  "i": 37,
  "start": 58.5,
  "end": 60.14,
  "text": "刚开始用一个新工具的时候"
 },
 {
  "i": 38,
  "start": 60.14,
  "end": 61.34,
  "text": "能只读就只读"
 },
 {
  "i": 39,
  "start": 61.34,
  "end": 62.61,
  "text": "让它先看不改"
 },
 {
  "i": 40,
  "start": 62.62,
  "end": 64.26,
  "text": "等你摸清楚它靠不靠谱了"
 },
 {
  "i": 41,
  "start": 64.26,
  "end": 65.29,
  "text": "再慢慢放开"
 },
 {
  "i": 42,
  "start": 65.57,
  "end": 67.84,
  "text": "第二 危险操作一定让它先问你"
 },
 {
  "i": 43,
  "start": 67.97,
  "end": 71.32,
  "text": "删除文件、付款、发消息、改线上的数据"
 },
 {
  "i": 44,
  "start": 71.37,
  "end": 73.69,
  "text": "这几类最好设置成每次都要你点确认"
 },
 {
  "i": 45,
  "start": 73.69,
  "end": 75.48,
  "text": "别图省事全部自动同意"
 },
 {
  "i": 46,
  "start": 75.67,
  "end": 76.55,
  "text": "而且点之前"
 },
 {
  "i": 47,
  "start": 76.55,
  "end": 78.58,
  "text": "花两秒看清楚它到底要干什么"
 },
 {
  "i": 48,
  "start": 78.75,
  "end": 80.74,
  "text": "第三 重要的东西先备份"
 },
 {
  "i": 49,
  "start": 80.91,
  "end": 82.59,
  "text": "让它在一份副本上动手"
 },
 {
  "i": 50,
  "start": 82.59,
  "end": 84.34,
  "text": "或者先把文件存一个版本"
 },
 {
  "i": 51,
  "start": 84.39,
  "end": 86.07,
  "text": "这样一来 就算它真的改坏了"
 },
 {
  "i": 52,
  "start": 86.07,
  "end": 87.42,
  "text": "你也随时能退回去"
 },
 {
  "i": 53,
  "start": 87.67,
  "end": 89.43,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 54,
  "start": 89.43,
  "end": 90.5,
  "text": "我们下期再见"
 }
]
