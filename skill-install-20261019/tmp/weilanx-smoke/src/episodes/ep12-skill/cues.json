[
 {
  "i": 1,
  "start": 0.38,
  "end": 1.29,
  "text": "这期视频"
 },
 {
  "i": 2,
  "start": 1.3,
  "end": 2.86,
  "text": "我只跟 AI 说了一句话"
 },
 {
  "i": 3,
  "start": 2.86,
  "end": 4.13,
  "text": "就是做一期 Skill"
 },
 {
  "i": 4,
  "start": 4.42,
  "end": 6.85,
  "text": "然后从写稿、配音、做字幕"
 },
 {
  "i": 5,
  "start": 6.98,
  "end": 9.57,
  "text": "到画这些动画、写发布文案"
 },
 {
  "i": 6,
  "start": 9.58,
  "end": 12.13,
  "text": "都是它按照我写好的流程一步步做完的"
 },
 {
  "i": 7,
  "start": 12.28,
  "end": 14.63,
  "text": "可它怎么知道我想要的视频长什么样呢"
 },
 {
  "i": 8,
  "start": 14.76,
  "end": 16.24,
  "text": "答案就在这期的主题里"
 },
 {
  "i": 9,
  "start": 16.24,
  "end": 17.03,
  "text": "叫做 Skill"
 },
 {
  "i": 10,
  "start": 17.2,
  "end": 19.19,
  "text": "也就是交给 AI 的技能说明书"
 },
 {
  "i": 11,
  "start": 19.44,
  "end": 20.63,
  "text": "上期讲的 MCP"
 },
 {
  "i": 12,
  "start": 20.64,
  "end": 22.24,
  "text": "是给 AI 接上新的工具"
 },
 {
  "i": 13,
  "start": 22.24,
  "end": 23.59,
  "text": "让它能做更多的事"
 },
 {
  "i": 14,
  "start": 23.75,
  "end": 25.34,
  "text": "而 Skill 管的是另一件事"
 },
 {
  "i": 15,
  "start": 25.35,
  "end": 27.14,
  "text": "就是怎么做才符合你的要求"
 },
 {
  "i": 16,
  "start": 27.31,
  "end": 29.74,
  "text": "你可以把它理解成一本写好的工作手册"
 },
 {
  "i": 17,
  "start": 29.83,
  "end": 31.62,
  "text": "里面写清楚这件事分几步"
 },
 {
  "i": 18,
  "start": 31.63,
  "end": 32.75,
  "text": "每一步用什么工具"
 },
 {
  "i": 19,
  "start": 32.75,
  "end": 34.71,
  "text": "有哪些要求、哪些坑不能踩"
 },
 {
  "i": 20,
  "start": 34.71,
  "end": 36.22,
  "text": "还可以附上模板和脚本"
 },
 {
  "i": 21,
  "start": 36.42,
  "end": 37.77,
  "text": "比如我做视频的这个 Skill"
 },
 {
  "i": 22,
  "start": 37.78,
  "end": 39.3,
  "text": "就写着稿子要写多少字"
 },
 {
  "i": 23,
  "start": 39.3,
  "end": 40.46,
  "text": "配音要加速多少"
 },
 {
  "i": 24,
  "start": 40.46,
  "end": 41.54,
  "text": "画面用什么风格"
 },
 {
  "i": 25,
  "start": 41.54,
  "end": 42.86,
  "text": "还有做完要先给我预览"
 },
 {
  "i": 26,
  "start": 42.86,
  "end": 44.25,
  "text": "我点头了才能导出"
 },
 {
  "i": 27,
  "start": 44.34,
  "end": 46.1,
  "text": "那 AI 手里有这么多本手册"
 },
 {
  "i": 28,
  "start": 46.1,
  "end": 47.77,
  "text": "会不会把上下文塞满呢"
 },
 {
  "i": 29,
  "start": 47.94,
  "end": 48.65,
  "text": "其实不会"
 },
 {
  "i": 30,
  "start": 48.66,
  "end": 50.34,
  "text": "因为平时它只看每本手册的名字"
 },
 {
  "i": 31,
  "start": 50.34,
  "end": 51.29,
  "text": "和一句简介"
 },
 {
  "i": 32,
  "start": 51.3,
  "end": 52.5,
  "text": "等你的需求对上了"
 },
 {
  "i": 33,
  "start": 52.5,
  "end": 54.29,
  "text": "才会把整本手册翻开来读"
 },
 {
  "i": 34,
  "start": 54.42,
  "end": 56.21,
  "text": "所以你可以放心地装很多个 Skill"
 },
 {
  "i": 35,
  "start": 56.3,
  "end": 58.05,
  "text": "用到哪个才占用哪个的地方"
 },
 {
  "i": 36,
  "start": 58.37,
  "end": 59.77,
  "text": "那怎么给自己写一个呢"
 },
 {
  "i": 37,
  "start": 59.77,
  "end": 61.12,
  "text": "这里分享三个建议"
 },
 {
  "i": 38,
  "start": 61.33,
  "end": 63.64,
  "text": "第一 从你反复交代的事情开始"
 },
 {
  "i": 39,
  "start": 63.81,
  "end": 64.73,
  "text": "如果同一套要求"
 },
 {
  "i": 40,
  "start": 64.73,
  "end": 66.24,
  "text": "你已经跟 AI 说过好几遍"
 },
 {
  "i": 41,
  "start": 66.25,
  "end": 68.61,
  "text": "比如周报的格式、回复客户的语气"
 },
 {
  "i": 42,
  "start": 68.61,
  "end": 70.2,
  "text": "那就值得把它写成一个 Skill"
 },
 {
  "i": 43,
  "start": 70.25,
  "end": 71.64,
  "text": "以后一句话就能调出来"
 },
 {
  "i": 44,
  "start": 72.07,
  "end": 74.3,
  "text": "第二 简介要写清楚什么时候用"
 },
 {
  "i": 45,
  "start": 74.35,
  "end": 75.91,
  "text": "因为 AI 就是靠这一句简介"
 },
 {
  "i": 46,
  "start": 75.91,
  "end": 77.51,
  "text": "来判断要不要翻开手册的"
 },
 {
  "i": 47,
  "start": 77.51,
  "end": 78.38,
  "text": "写得太模糊"
 },
 {
  "i": 48,
  "start": 78.43,
  "end": 80.18,
  "text": "它可能在该用的时候想不起来"
 },
 {
  "i": 49,
  "start": 80.47,
  "end": 81.94,
  "text": "第三 边用边改"
 },
 {
  "i": 50,
  "start": 82.13,
  "end": 83.01,
  "text": "每次它做得不对"
 },
 {
  "i": 51,
  "start": 83.01,
  "end": 84.01,
  "text": "你纠正完之后"
 },
 {
  "i": 52,
  "start": 84.01,
  "end": 85.8,
  "text": "就把这条经验补进手册里"
 },
 {
  "i": 53,
  "start": 85.81,
  "end": 87.57,
  "text": "这样一来 它就会越用越顺手"
 },
 {
  "i": 54,
  "start": 87.57,
  "end": 89.33,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 55,
  "start": 89.33,
  "end": 90.32,
  "text": "我们下期再见"
 }
]
