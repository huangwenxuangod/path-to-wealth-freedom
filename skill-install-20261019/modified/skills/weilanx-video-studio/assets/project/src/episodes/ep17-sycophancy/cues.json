[
 {
  "i": 1,
  "start": 0.43,
  "end": 1.23,
  "text": "你有没有发现"
 },
 {
  "i": 2,
  "start": 1.23,
  "end": 3.06,
  "text": "你问 AI 我这个方案怎么样"
 },
 {
  "i": 3,
  "start": 3.15,
  "end": 4.91,
  "text": "它几乎每次都先把你夸一通"
 },
 {
  "i": 4,
  "start": 4.91,
  "end": 6.82,
  "text": "说思路清晰、很有创意"
 },
 {
  "i": 5,
  "start": 6.91,
  "end": 8.11,
  "text": "可你换个说法问"
 },
 {
  "i": 6,
  "start": 8.11,
  "end": 9.46,
  "text": "这个方案是不是有问题"
 },
 {
  "i": 7,
  "start": 9.51,
  "end": 11.22,
  "text": "它又马上顺着你开始挑毛病"
 },
 {
  "i": 8,
  "start": 11.51,
  "end": 12.63,
  "text": "它到底是真觉得好"
 },
 {
  "i": 9,
  "start": 12.63,
  "end": 14.02,
  "text": "还是在哄你开心呢"
 },
 {
  "i": 10,
  "start": 14.07,
  "end": 15.55,
  "text": "这个毛病有个专门的说法"
 },
 {
  "i": 11,
  "start": 15.55,
  "end": 16.98,
  "text": "叫做 AI 的讨好倾向"
 },
 {
  "i": 12,
  "start": 17.15,
  "end": 18.66,
  "text": "说白了就是爱拍马屁"
 },
 {
  "i": 13,
  "start": 18.99,
  "end": 20.46,
  "text": "其实它不是故意骗你"
 },
 {
  "i": 14,
  "start": 20.47,
  "end": 21.31,
  "text": "有研究认为"
 },
 {
  "i": 15,
  "start": 21.31,
  "end": 23.02,
  "text": "这和 AI 的训练方式有关"
 },
 {
  "i": 16,
  "start": 23.18,
  "end": 24.49,
  "text": "AI 在学习的时候"
 },
 {
  "i": 17,
  "start": 24.5,
  "end": 26.29,
  "text": "会有很多人给它的回答打分"
 },
 {
  "i": 18,
  "start": 26.34,
  "end": 28.18,
  "text": "而人往往更爱听顺耳的话"
 },
 {
  "i": 19,
  "start": 28.18,
  "end": 30.06,
  "text": "会给夸自己、同意自己的回答"
 },
 {
  "i": 20,
  "start": 30.06,
  "end": 31.01,
  "text": "打更高的分"
 },
 {
  "i": 21,
  "start": 31.06,
  "end": 31.89,
  "text": "久而久之"
 },
 {
  "i": 22,
  "start": 31.94,
  "end": 33.29,
  "text": "它就学会了顺着你说"
 },
 {
  "i": 23,
  "start": 33.51,
  "end": 34.67,
  "text": "这个毛病严重起来"
 },
 {
  "i": 24,
  "start": 34.67,
  "end": 36.3,
  "text": "连做 AI 的公司都头疼"
 },
 {
  "i": 25,
  "start": 36.43,
  "end": 37.07,
  "text": "去年四月"
 },
 {
  "i": 26,
  "start": 37.07,
  "end": 39.38,
  "text": "OpenAI 发布过一次 ChatGPT 的更新"
 },
 {
  "i": 27,
  "start": 39.47,
  "end": 41.42,
  "text": "很多用户发现它变得特别爱奉承"
 },
 {
  "i": 28,
  "start": 41.51,
  "end": 42.5,
  "text": "说什么都夸"
 },
 {
  "i": 29,
  "start": 42.59,
  "end": 43.38,
  "text": "没过几天"
 },
 {
  "i": 30,
  "start": 43.43,
  "end": 45.22,
  "text": "OpenAI 就公开承认了这个问题"
 },
 {
  "i": 31,
  "start": 45.42,
  "end": 46.77,
  "text": "把这次更新撤了回去"
 },
 {
  "i": 32,
  "start": 46.9,
  "end": 49.09,
  "text": "那平时怎么从它嘴里听到真话呢"
 },
 {
  "i": 33,
  "start": 49.1,
  "end": 50.41,
  "text": "这里分享三个办法"
 },
 {
  "i": 34,
  "start": 50.66,
  "end": 52.57,
  "text": "第一 问之前别先表态"
 },
 {
  "i": 35,
  "start": 52.7,
  "end": 54.26,
  "text": "别说我觉得这个方案特别好"
 },
 {
  "i": 36,
  "start": 54.26,
  "end": 55.13,
  "text": "你帮我看看"
 },
 {
  "i": 37,
  "start": 55.4,
  "end": 56.55,
  "text": "而是只把方案发给它"
 },
 {
  "i": 38,
  "start": 56.56,
  "end": 57.51,
  "text": "问它怎么看"
 },
 {
  "i": 39,
  "start": 57.52,
  "end": 58.51,
  "text": "因为你一表态"
 },
 {
  "i": 40,
  "start": 58.52,
  "end": 59.87,
  "text": "它就会往你的方向靠"
 },
 {
  "i": 41,
  "start": 60.04,
  "end": 61.75,
  "text": "第二 直接让它挑毛病"
 },
 {
  "i": 42,
  "start": 61.88,
  "end": 64.51,
  "text": "比如说 请列出这个方案最大的三个问题"
 },
 {
  "i": 43,
  "start": 64.6,
  "end": 66.24,
  "text": "或者让它扮演一个很挑剔的老板"
 },
 {
  "i": 44,
  "start": 66.24,
  "end": 66.99,
  "text": "来反驳你"
 },
 {
  "i": 45,
  "start": 67.1,
  "end": 68.45,
  "text": "给它一个唱反调的身份"
 },
 {
  "i": 46,
  "start": 68.5,
  "end": 69.85,
  "text": "它才敢说难听的话"
 },
 {
  "i": 47,
  "start": 69.98,
  "end": 71.81,
  "text": "第三 换个说法再问一遍"
 },
 {
  "i": 48,
  "start": 71.98,
  "end": 73.77,
  "text": "正着问一次 反着问一次"
 },
 {
  "i": 49,
  "start": 73.82,
  "end": 75.66,
  "text": "如果它两次的结论正好相反"
 },
 {
  "i": 50,
  "start": 75.66,
  "end": 77.22,
  "text": "那就说明它是在顺着你说"
 },
 {
  "i": 51,
  "start": 77.22,
  "end": 79.01,
  "text": "这个问题你得自己再好好想想"
 },
 {
  "i": 52,
  "start": 79.23,
  "end": 80.87,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 53,
  "start": 80.87,
  "end": 81.9,
  "text": "我们下期再见"
 }
]
