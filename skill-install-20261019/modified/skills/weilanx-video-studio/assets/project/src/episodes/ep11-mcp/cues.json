[
 {
  "i": 1,
  "start": 0.42,
  "end": 2.73,
  "text": "以前你让 AI 帮你看看明天有什么安排"
 },
 {
  "i": 2,
  "start": 2.82,
  "end": 3.98,
  "text": "它只会说抱歉"
 },
 {
  "i": 3,
  "start": 3.98,
  "end": 5.41,
  "text": "我没办法访问你的日历"
 },
 {
  "i": 4,
  "start": 5.5,
  "end": 7.93,
  "text": "可现在不少 AI 已经能直接读你的日历"
 },
 {
  "i": 5,
  "start": 7.98,
  "end": 8.9,
  "text": "改你的表格"
 },
 {
  "i": 6,
  "start": 8.9,
  "end": 10.93,
  "text": "还能去代码仓库里帮你提交修改"
 },
 {
  "i": 7,
  "start": 11.16,
  "end": 13.11,
  "text": "它是怎么突然长出这些手脚的呢"
 },
 {
  "i": 8,
  "start": 13.12,
  "end": 14.84,
  "text": "这背后有一样很关键的东西"
 },
 {
  "i": 9,
  "start": 14.84,
  "end": 15.96,
  "text": "叫做 MCP"
 },
 {
  "i": 10,
  "start": 15.96,
  "end": 17.75,
  "text": "全称是模型上下文协议"
 },
 {
  "i": 11,
  "start": 17.84,
  "end": 18.8,
  "text": "我们之前讲过"
 },
 {
  "i": 12,
  "start": 18.8,
  "end": 20.8,
  "text": "Agent 就是大模型加上工具"
 },
 {
  "i": 13,
  "start": 20.8,
  "end": 21.91,
  "text": "再加上一个循环"
 },
 {
  "i": 14,
  "start": 21.92,
  "end": 24.55,
  "text": "但问题是这些工具要怎么接到 AI 身上呢"
 },
 {
  "i": 15,
  "start": 24.69,
  "end": 26.04,
  "text": "在 MCP 出现之前"
 },
 {
  "i": 16,
  "start": 26.05,
  "end": 27.61,
  "text": "每个 AI 应用想用一个工具"
 },
 {
  "i": 17,
  "start": 27.61,
  "end": 29.21,
  "text": "都得单独写一套对接代码"
 },
 {
  "i": 18,
  "start": 29.21,
  "end": 31.12,
  "text": "日历要接一遍 表格要接一遍"
 },
 {
  "i": 19,
  "start": 31.13,
  "end": 33.24,
  "text": "换一个 AI 应用又得从头再接一遍"
 },
 {
  "i": 20,
  "start": 33.25,
  "end": 35.29,
  "text": "就像以前每部手机都有自己的充电口"
 },
 {
  "i": 21,
  "start": 35.29,
  "end": 36.96,
  "text": "出门得带一堆不同的充电线"
 },
 {
  "i": 22,
  "start": 37.12,
  "end": 38.32,
  "text": "MCP 做的事情"
 },
 {
  "i": 23,
  "start": 38.32,
  "end": 40.11,
  "text": "就是给 AI 定了一个统一的插座"
 },
 {
  "i": 24,
  "start": 40.24,
  "end": 42,
  "text": "它是 Anthropic 在 2024 年底"
 },
 {
  "i": 25,
  "start": 42,
  "end": 43.23,
  "text": "提出的一套公开标准"
 },
 {
  "i": 26,
  "start": 43.32,
  "end": 45.95,
  "text": "后来很多 AI 公司和开发工具都跟进支持了"
 },
 {
  "i": 27,
  "start": 45.96,
  "end": 47.96,
  "text": "做工具的人只要按这个标准写一次"
 },
 {
  "i": 28,
  "start": 47.96,
  "end": 50.07,
  "text": "就能插到所有支持 MCP 的 AI 上"
 },
 {
  "i": 29,
  "start": 50.16,
  "end": 51.12,
  "text": "所以官方把它比作"
 },
 {
  "i": 30,
  "start": 51.12,
  "end": 52.63,
  "text": "AI 应用的 USB-C 接口"
 },
 {
  "i": 31,
  "start": 52.72,
  "end": 53.32,
  "text": "插上之后"
 },
 {
  "i": 32,
  "start": 53.32,
  "end": 55.31,
  "text": "AI 会先问这个工具你能做什么"
 },
 {
  "i": 33,
  "start": 55.36,
  "end": 56.88,
  "text": "工具就把自己的本事列出来"
 },
 {
  "i": 34,
  "start": 56.88,
  "end": 58.63,
  "text": "比如查看日程、新建日程"
 },
 {
  "i": 35,
  "start": 58.72,
  "end": 59.71,
  "text": "等你提出需求"
 },
 {
  "i": 36,
  "start": 59.8,
  "end": 61.76,
  "text": "AI 就自己挑一个合适的工具去调用"
 },
 {
  "i": 37,
  "start": 61.76,
  "end": 62.64,
  "text": "拿到结果之后"
 },
 {
  "i": 38,
  "start": 62.64,
  "end": 63.79,
  "text": "再接着决定下一步"
 },
 {
  "i": 39,
  "start": 63.98,
  "end": 65.14,
  "text": "那我们平时怎么用呢"
 },
 {
  "i": 40,
  "start": 65.14,
  "end": 66.37,
  "text": "这里分享三个建议"
 },
 {
  "i": 41,
  "start": 66.54,
  "end": 68.85,
  "text": "第一 先去你常用的 AI 应用里找一找"
 },
 {
  "i": 42,
  "start": 68.86,
  "end": 70.94,
  "text": "设置里通常叫连接器或者 MCP"
 },
 {
  "i": 43,
  "start": 70.94,
  "end": 73.81,
  "text": "把每天都在用的日历、笔记、网盘接上"
 },
 {
  "i": 44,
  "start": 73.82,
  "end": 75.73,
  "text": "它能帮你干的活一下子就多了很多"
 },
 {
  "i": 45,
  "start": 75.93,
  "end": 77.61,
  "text": "第二 只装信得过的来源"
 },
 {
  "i": 46,
  "start": 77.61,
  "end": 79.64,
  "text": "因为接上之后它就能读写你的数据"
 },
 {
  "i": 47,
  "start": 79.65,
  "end": 80.69,
  "text": "来路不明的工具"
 },
 {
  "i": 48,
  "start": 80.69,
  "end": 82.32,
  "text": "可能会把你的信息泄露出去"
 },
 {
  "i": 49,
  "start": 82.41,
  "end": 84.01,
  "text": "第三 用不到的就关掉"
 },
 {
  "i": 50,
  "start": 84.01,
  "end": 85.16,
  "text": "因为每接一个工具"
 },
 {
  "i": 51,
  "start": 85.17,
  "end": 87.03999999999999,
  "text": "它的说明都会占用 AI 的上下文"
 },
 {
  "i": 52,
  "start": 87.09,
  "end": 89.13,
  "text": "接得太多 AI 反而容易挑错工具"
 },
 {
  "i": 53,
  "start": 89.13,
  "end": 90,
  "text": "也更费 token"
 },
 {
  "i": 54,
  "start": 90.15,
  "end": 91.78999999999999,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 55,
  "start": 91.78999999999999,
  "end": 92.78,
  "text": "我们下期再见"
 }
]
