[
 {
  "i": 1,
  "start": 0.52,
  "end": 1.64,
  "text": "美国有一位律师"
 },
 {
  "i": 2,
  "start": 1.64,
  "end": 3.36,
  "text": "让 ChatGPT 帮他找判例"
 },
 {
  "i": 3,
  "start": 3.36,
  "end": 4.47,
  "text": "写进法庭文件"
 },
 {
  "i": 4,
  "start": 4.56,
  "end": 5.95,
  "text": "引用得有模有样"
 },
 {
  "i": 5,
  "start": 6,
  "end": 7.07,
  "text": "结果法官一查"
 },
 {
  "i": 6,
  "start": 7.08,
  "end": 9.07,
  "text": "里面好几个判例根本就不存在"
 },
 {
  "i": 7,
  "start": 9.12,
  "end": 10.95,
  "text": "最后这位律师还被罚了款"
 },
 {
  "i": 8,
  "start": 11.23,
  "end": 12.11,
  "text": "这么离谱的错"
 },
 {
  "i": 9,
  "start": 12.11,
  "end": 14.22,
  "text": "AI 为什么能说得那么自信呢"
 },
 {
  "i": 10,
  "start": 14.31,
  "end": 15.95,
  "text": "这背后有一个专门的说法"
 },
 {
  "i": 11,
  "start": 15.95,
  "end": 17.26,
  "text": "叫做 AI 幻觉"
 },
 {
  "i": 12,
  "start": 17.35,
  "end": 19.43,
  "text": "也就是 AI 一本正经地说出一段"
 },
 {
  "i": 13,
  "start": 19.43,
  "end": 20.34,
  "text": "看起来很对"
 },
 {
  "i": 14,
  "start": 20.35,
  "end": 22.14,
  "text": "其实是它自己编出来的内容"
 },
 {
  "i": 15,
  "start": 22.39,
  "end": 23.39,
  "text": "要理解幻觉"
 },
 {
  "i": 16,
  "start": 23.39,
  "end": 24.63,
  "text": "得先记住一件事"
 },
 {
  "i": 17,
  "start": 24.63,
  "end": 26.47,
  "text": "就是大模型在回答你的时候"
 },
 {
  "i": 18,
  "start": 26.47,
  "end": 28.07,
  "text": "其实不是去资料库里查"
 },
 {
  "i": 19,
  "start": 28.07,
  "end": 30.34,
  "text": "而是在猜下一个词最可能是什么"
 },
 {
  "i": 20,
  "start": 30.55,
  "end": 31.86,
  "text": "它读过海量的文字"
 },
 {
  "i": 21,
  "start": 31.91,
  "end": 33.95,
  "text": "很清楚一个判例名 一本书名"
 },
 {
  "i": 22,
  "start": 33.95,
  "end": 35.78,
  "text": "一个网址通常长什么样子"
 },
 {
  "i": 23,
  "start": 36.05,
  "end": 37.65,
  "text": "所以就算它根本不知道答案"
 },
 {
  "i": 24,
  "start": 37.65,
  "end": 40.01,
  "text": "也能顺着格式凑出一个像模像样的"
 },
 {
  "i": 25,
  "start": 40.01,
  "end": 41.56,
  "text": "而且语气还特别笃定"
 },
 {
  "i": 26,
  "start": 41.69,
  "end": 43.76,
  "text": "另外 它也不太习惯说不知道"
 },
 {
  "i": 27,
  "start": 43.89,
  "end": 44.85,
  "text": "有研究认为"
 },
 {
  "i": 28,
  "start": 44.85,
  "end": 47.33,
  "text": "现在很多评测更奖励模型猜一个答案"
 },
 {
  "i": 29,
  "start": 47.33,
  "end": 49.36,
  "text": "而不是老老实实承认自己不确定"
 },
 {
  "i": 30,
  "start": 49.53,
  "end": 51.12,
  "text": "这也是它爱编的一个原因"
 },
 {
  "i": 31,
  "start": 51.29,
  "end": 52.92,
  "text": "所以越是冷门的知识"
 },
 {
  "i": 32,
  "start": 52.97,
  "end": 55.69,
  "text": "具体的数字 人名 书名和链接"
 },
 {
  "i": 33,
  "start": 55.69,
  "end": 57,
  "text": "越容易出现幻觉"
 },
 {
  "i": 34,
  "start": 57.13,
  "end": 58.68,
  "text": "那我们平时怎么防呢"
 },
 {
  "i": 35,
  "start": 58.73,
  "end": 60.12,
  "text": "这里分享三个做法"
 },
 {
  "i": 36,
  "start": 60.35,
  "end": 62.86,
  "text": "第一 把资料给它 让它照着回答"
 },
 {
  "i": 37,
  "start": 63.03,
  "end": 64.87,
  "text": "比如你想问一份合同里的条款"
 },
 {
  "i": 38,
  "start": 64.87,
  "end": 66.43,
  "text": "就把合同原文贴进去"
 },
 {
  "i": 39,
  "start": 66.43,
  "end": 68.46000000000001,
  "text": "再告诉它只根据这些内容回答"
 },
 {
  "i": 40,
  "start": 68.51,
  "end": 70.02,
  "text": "这样它就不用靠猜了"
 },
 {
  "i": 41,
  "start": 70.27,
  "end": 71.82,
  "text": "第二 允许它说不知道"
 },
 {
  "i": 42,
  "start": 71.91,
  "end": 73.31,
  "text": "在提示词里加一句"
 },
 {
  "i": 43,
  "start": 73.31,
  "end": 75.34,
  "text": "不确定的地方就直接说不确定"
 },
 {
  "i": 44,
  "start": 75.43,
  "end": 76.9,
  "text": "因为你不给它这个台阶"
 },
 {
  "i": 45,
  "start": 76.95,
  "end": 79.1,
  "text": "它往往会硬着头皮编一个答案出来"
 },
 {
  "i": 46,
  "start": 79.31,
  "end": 80.82,
  "text": "第三 让它给出处"
 },
 {
  "i": 47,
  "start": 80.91,
  "end": 82.74,
  "text": "关键信息自己再核实一遍"
 },
 {
  "i": 48,
  "start": 82.95,
  "end": 84.94,
  "text": "尤其是数字 人名和链接"
 },
 {
  "i": 49,
  "start": 84.99,
  "end": 86.47,
  "text": "花一分钟点开查一查"
 },
 {
  "i": 50,
  "start": 86.47,
  "end": 88.47,
  "text": "比事后发现被骗要划算得多"
 },
 {
  "i": 51,
  "start": 88.47,
  "end": 90.51,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 52,
  "start": 90.51,
  "end": 91.62,
  "text": "我们下期再见"
 }
]
