[
 {
  "i": 1,
  "start": 0.53,
  "end": 2.97,
  "text": "打开冰箱随手拍一张照片发给 AI"
 },
 {
  "i": 2,
  "start": 2.97,
  "end": 4.64,
  "text": "它能认出里面有两个番茄"
 },
 {
  "i": 3,
  "start": 4.69,
  "end": 6.28,
  "text": "半颗白菜和一盒鸡蛋"
 },
 {
  "i": 4,
  "start": 6.37,
  "end": 8.57,
  "text": "然后告诉你今晚可以做一道番茄炒蛋"
 },
 {
  "i": 5,
  "start": 8.57,
  "end": 9.8,
  "text": "再炒个醋溜白菜"
 },
 {
  "i": 6,
  "start": 9.89,
  "end": 11.08,
  "text": "可我们之前说过"
 },
 {
  "i": 7,
  "start": 11.23,
  "end": 13.34,
  "text": "大模型是一个靠文字接龙的高手"
 },
 {
  "i": 8,
  "start": 13.47,
  "end": 15.26,
  "text": "它怎么突然就看得懂照片了呢"
 },
 {
  "i": 9,
  "start": 15.27,
  "end": 17.46,
  "text": "这背后的本事有个专门的名字"
 },
 {
  "i": 10,
  "start": 17.51,
  "end": 18.5,
  "text": "叫做多模态"
 },
 {
  "i": 11,
  "start": 19.03,
  "end": 20.74,
  "text": "模态说的就是信息的形式"
 },
 {
  "i": 12,
  "start": 20.87,
  "end": 21.78,
  "text": "文字是一种"
 },
 {
  "i": 13,
  "start": 22,
  "end": 24.59,
  "text": "图片、声音、视频也各是一种"
 },
 {
  "i": 14,
  "start": 24.72,
  "end": 26.4,
  "text": "以前的 AI 基本只会读字"
 },
 {
  "i": 15,
  "start": 26.4,
  "end": 27.44,
  "text": "而多模态的 AI"
 },
 {
  "i": 16,
  "start": 27.44,
  "end": 29.51,
  "text": "能同时接收好几种形式的信息"
 },
 {
  "i": 17,
  "start": 29.72,
  "end": 31.92,
  "text": "所以你可以给它发照片、发截图"
 },
 {
  "i": 18,
  "start": 31.92,
  "end": 33.83,
  "text": "直接跟它说话 它都接得住"
 },
 {
  "i": 19,
  "start": 34.15,
  "end": 35.86,
  "text": "那它是怎么看懂一张图的呢"
 },
 {
  "i": 20,
  "start": 35.99,
  "end": 37.9,
  "text": "还记得我们之前讲过的 token 吗"
 },
 {
  "i": 21,
  "start": 37.95,
  "end": 40.06,
  "text": "文字在 AI 眼里是一块块积木"
 },
 {
  "i": 22,
  "start": 40.15,
  "end": 41.3,
  "text": "其实图片也一样"
 },
 {
  "i": 23,
  "start": 41.39,
  "end": 43.42,
  "text": "它会把一张图切成很多小方块"
 },
 {
  "i": 24,
  "start": 43.51,
  "end": 45.58,
  "text": "每一块都变成和文字差不多的积木"
 },
 {
  "i": 25,
  "start": 45.87,
  "end": 47.74,
  "text": "声音也会被切成一小段一小段"
 },
 {
  "i": 26,
  "start": 47.83,
  "end": 49.99,
  "text": "这样一来 文字、图片和声音"
 },
 {
  "i": 27,
  "start": 49.99,
  "end": 51.82,
  "text": "在它眼里都变成了同一种东西"
 },
 {
  "i": 28,
  "start": 51.99,
  "end": 53.82,
  "text": "它就能用同一个脑子一起理解"
 },
 {
  "i": 29,
  "start": 53.83,
  "end": 55.98,
  "text": "再照样一个字一个字地接着回答你"
 },
 {
  "i": 30,
  "start": 56.21,
  "end": 57.05,
  "text": "知道了这一点"
 },
 {
  "i": 31,
  "start": 57.05,
  "end": 58.65,
  "text": "平时用 AI 就可以更省事"
 },
 {
  "i": 32,
  "start": 58.65,
  "end": 60.04,
  "text": "这里分享三个用法"
 },
 {
  "i": 33,
  "start": 60.17,
  "end": 62.04,
  "text": "第一 能截图就别打字"
 },
 {
  "i": 34,
  "start": 62.13,
  "end": 63.96,
  "text": "比如电脑弹出一大段报错"
 },
 {
  "i": 35,
  "start": 63.97,
  "end": 65.44,
  "text": "或者你看不懂一张表格"
 },
 {
  "i": 36,
  "start": 65.45,
  "end": 66.56,
  "text": "直接截图发给它"
 },
 {
  "i": 37,
  "start": 66.83,
  "end": 68.19,
  "text": "因为你打字描述的时候"
 },
 {
  "i": 38,
  "start": 68.19,
  "end": 69.74,
  "text": "很容易漏掉关键的信息"
 },
 {
  "i": 39,
  "start": 69.95,
  "end": 72.26,
  "text": "第二 拍下现实里的东西直接问"
 },
 {
  "i": 40,
  "start": 72.31,
  "end": 74.31,
  "text": "看不懂的说明书、外文菜单"
 },
 {
  "i": 41,
  "start": 74.31,
  "end": 75.62,
  "text": "路边不认识的植物"
 },
 {
  "i": 42,
  "start": 75.63,
  "end": 77.91,
  "text": "拍一张照片问它是什么、该怎么用"
 },
 {
  "i": 43,
  "start": 77.91,
  "end": 79.5,
  "text": "比你自己去搜要快得多"
 },
 {
  "i": 44,
  "start": 79.76,
  "end": 82.51,
  "text": "第三 图要清楚 关键信息要核对"
 },
 {
  "i": 45,
  "start": 82.6,
  "end": 83.83,
  "text": "它看图也会看错"
 },
 {
  "i": 46,
  "start": 83.84,
  "end": 86.19,
  "text": "尤其是很小的字、密密麻麻的数字"
 },
 {
  "i": 47,
  "start": 86.2,
  "end": 88.27,
  "text": "还有要它数清楚有几个东西的时候"
 },
 {
  "i": 48,
  "start": 88.32,
  "end": 89.92,
  "text": "所以只截你要问的那一块"
 },
 {
  "i": 49,
  "start": 89.92,
  "end": 91.55,
  "text": "重要的数字自己再看一眼"
 },
 {
  "i": 50,
  "start": 91.66,
  "end": 93.42,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 51,
  "start": 93.42,
  "end": 94.45,
  "text": "我们下期再见"
 }
]
