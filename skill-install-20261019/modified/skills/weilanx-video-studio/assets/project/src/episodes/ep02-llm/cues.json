[
 {
  "i": 1,
  "start": 0.113,
  "end": 1.191,
  "text": "我说床前明月"
 },
 {
  "i": 2,
  "start": 1.261,
  "end": 2.339,
  "text": "你脑子里是不是自然"
 },
 {
  "i": 3,
  "start": 2.339,
  "end": 3.243,
  "text": "就蹦出一个光字"
 },
 {
  "i": 4,
  "start": 3.591,
  "end": 5.539,
  "text": "恭喜你你刚刚干了一次大模型的活"
 },
 {
  "i": 5,
  "start": 5.843,
  "end": 7.27,
  "text": "GPT Claude 这些 AI 背后"
 },
 {
  "i": 6,
  "start": 7.27,
  "end": 8.07,
  "text": "都是大语言模型"
 },
 {
  "i": 7,
  "start": 8.104,
  "end": 9.043,
  "text": "英文叫 LLM"
 },
 {
  "i": 8,
  "start": 9.426,
  "end": 10.748,
  "text": "它最核心的本事就一个"
 },
 {
  "i": 9,
  "start": 10.957,
  "end": 11.757,
  "text": "根据前面的话"
 },
 {
  "i": 10,
  "start": 11.791,
  "end": 13.322,
  "text": "猜下一个字最可能是什么"
 },
 {
  "i": 11,
  "start": 13.635,
  "end": 14.991,
  "text": "你问它今天天气怎么样"
 },
 {
  "i": 12,
  "start": 15.165,
  "end": 16.765,
  "text": "它不是一下子想好整段回答"
 },
 {
  "i": 13,
  "start": 17.052,
  "end": 18.2,
  "text": "而是先猜第一个字"
 },
 {
  "i": 14,
  "start": 18.374,
  "end": 20.078,
  "text": "接上再猜下一个字再接上"
 },
 {
  "i": 15,
  "start": 20.287,
  "end": 21.609,
  "text": "一个字一个字的接出来"
 },
 {
  "i": 16,
  "start": 21.887,
  "end": 22.826,
  "text": "所以你看它打字"
 },
 {
  "i": 17,
  "start": 22.826,
  "end": 24.426,
  "text": "是一个字一个字的往外蹦的"
 },
 {
  "i": 18,
  "start": 24.67,
  "end": 25.957,
  "text": "那为什么它猜的这么准"
 },
 {
  "i": 19,
  "start": 26.426,
  "end": 27.504,
  "text": "因为它在训练的时候"
 },
 {
  "i": 20,
  "start": 27.539,
  "end": 29.626,
  "text": "读了几乎整个互联网的那么多文字"
 },
 {
  "i": 21,
  "start": 30.113,
  "end": 32.757,
  "text": "小说论文代码聊天记录全都见过"
 },
 {
  "i": 22,
  "start": 32.965,
  "end": 33.522,
  "text": "见得多了"
 },
 {
  "i": 23,
  "start": 33.522,
  "end": 35.157,
  "text": "就知道什么话后面该跟什么话"
 },
 {
  "i": 24,
  "start": 35.643,
  "end": 36.965,
  "text": "你可以把它想成一个"
 },
 {
  "i": 25,
  "start": 37,
  "end": 38.739,
  "text": "读过亿万本书的接龙高手"
 },
 {
  "i": 26,
  "start": 39.052,
  "end": 39.922,
  "text": "但这也解释了"
 },
 {
  "i": 27,
  "start": 39.957,
  "end": 41.626,
  "text": "它为什么会一本正经的胡说八道"
 },
 {
  "i": 28,
  "start": 42.009,
  "end": 43.435,
  "text": "它是在猜不是在查"
 },
 {
  "i": 29,
  "start": 43.817,
  "end": 45,
  "text": "只要一句话听起来顺"
 },
 {
  "i": 30,
  "start": 45.174,
  "end": 46.148,
  "text": "它就说的头头是道"
 },
 {
  "i": 31,
  "start": 46.252,
  "end": 47.296,
  "text": "哪怕内容是编的"
 },
 {
  "i": 32,
  "start": 47.478,
  "end": 48.939,
  "text": "这就是大家常说的 AI 幻觉"
 },
 {
  "i": 33,
  "start": 49.235,
  "end": 50,
  "text": "一句话记住"
 },
 {
  "i": 34,
  "start": 50.243,
  "end": 51.739,
  "text": "大模型不是百科全书"
 },
 {
  "i": 35,
  "start": 51.774,
  "end": 53.722,
  "text": "而是一个超级会接话的接龙高手"
 },
 {
  "i": 36,
  "start": 54.104,
  "end": 55.043,
  "text": "不过偷偷告诉你"
 },
 {
  "i": 37,
  "start": 55.252,
  "end": 56.365,
  "text": "它猜的其实不是字"
 },
 {
  "i": 38,
  "start": 56.4,
  "end": 57.687,
  "text": "而是一种叫 token 的东西"
 },
 {
  "i": 39,
  "start": 58.043,
  "end": 58.843,
  "text": "下期我们来聊聊"
 },
 {
  "i": 40,
  "start": 58.983,
  "end": 60.478,
  "text": "AI 眼里的字到底长什么样"
 },
 {
  "i": 41,
  "start": 60.809,
  "end": 61.991,
  "text": "别忘了点赞收藏关注"
 },
 {
  "i": 42,
  "start": 62.061,
  "end": 63.035,
  "text": "我们下期再见"
 }
]
