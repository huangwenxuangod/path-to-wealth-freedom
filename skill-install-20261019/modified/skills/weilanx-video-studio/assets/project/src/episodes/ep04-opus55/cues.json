[
 {
  "i": 1,
  "start": 0.17,
  "end": 1.45,
  "text": "我宣布 Opus 5.5"
 },
 {
  "i": 2,
  "start": 1.45,
  "end": 3.08,
  "text": "就是现在最强的甜点模型"
 },
 {
  "i": 3,
  "start": 3.13,
  "end": 4.17,
  "text": "性能接近旗舰"
 },
 {
  "i": 4,
  "start": 4.17,
  "end": 5.44,
  "text": "价格却便宜一大截"
 },
 {
  "i": 5,
  "start": 5.57,
  "end": 6.97,
  "text": "我前几期的动画视频"
 },
 {
  "i": 6,
  "start": 6.97,
  "end": 8.68,
  "text": "就是用 Opus 5.5 做出来的"
 },
 {
  "i": 7,
  "start": 8.77,
  "end": 9.89,
  "text": "这期我们就来看一下"
 },
 {
  "i": 8,
  "start": 9.89,
  "end": 11.2,
  "text": "大家为什么这么夸它"
 },
 {
  "i": 9,
  "start": 11.41,
  "end": 13.04,
  "text": "还有怎么用才能把它用好"
 },
 {
  "i": 10,
  "start": 13.25,
  "end": 14.08,
  "text": "先说强"
 },
 {
  "i": 11,
  "start": 14.21,
  "end": 17.44,
  "text": "第三方机构 Artificial Analysis 的智能指数"
 },
 {
  "i": 12,
  "start": 17.49,
  "end": 18.6,
  "text": "它拿了 58 分"
 },
 {
  "i": 13,
  "start": 18.77,
  "end": 20.28,
  "text": "发布当天就排第一"
 },
 {
  "i": 14,
  "start": 20.45,
  "end": 22.92,
  "text": "官方公布的 FrontierCode 测试里面"
 },
 {
  "i": 15,
  "start": 23.01,
  "end": 24.53,
  "text": "它只用了默认的 medium 档"
 },
 {
  "i": 16,
  "start": 24.53,
  "end": 27.08,
  "text": "就超过了 GPT-6 Astra 的最高成绩"
 },
 {
  "i": 17,
  "start": 27.39,
  "end": 28.43,
  "text": "每一个任务的成本"
 },
 {
  "i": 18,
  "start": 28.43,
  "end": 30.07,
  "text": "也只有对方的五分之一左右"
 },
 {
  "i": 19,
  "start": 30.07,
  "end": 32.59,
  "text": "Sentry 的创始人用它跑了几个大任务"
 },
 {
  "i": 20,
  "start": 32.59,
  "end": 34.82,
  "text": "说自己分不出它和 Fable 的区别"
 },
 {
  "i": 21,
  "start": 34.99,
  "end": 35.71,
  "text": "再说快"
 },
 {
  "i": 22,
  "start": 35.71,
  "end": 37.19,
  "text": "它并不是单纯吐字快"
 },
 {
  "i": 23,
  "start": 37.19,
  "end": 38.22,
  "text": "而是干活快"
 },
 {
  "i": 24,
  "start": 38.27,
  "end": 39.02,
  "text": "想得快"
 },
 {
  "i": 25,
  "start": 39.26,
  "end": 40.86,
  "text": "它想完一遍就能做对"
 },
 {
  "i": 26,
  "start": 40.86,
  "end": 42.85,
  "text": "GitHub 的测试里面也发现"
 },
 {
  "i": 27,
  "start": 43.02,
  "end": 44.02,
  "text": "完成同样的任务"
 },
 {
  "i": 28,
  "start": 44.02,
  "end": 46.29,
  "text": "它用的步骤和 token 明显更少"
 },
 {
  "i": 29,
  "start": 46.58,
  "end": 47.53,
  "text": "然后是便宜"
 },
 {
  "i": 30,
  "start": 47.66,
  "end": 48.86,
  "text": "每一个百万 token"
 },
 {
  "i": 31,
  "start": 48.86,
  "end": 50.73,
  "text": "输入 4 美元 输出 20 美元"
 },
 {
  "i": 32,
  "start": 51.02,
  "end": 52.61,
  "text": "比上一代便宜了两成"
 },
 {
  "i": 33,
  "start": 52.78,
  "end": 55.13,
  "text": "缓存读取更是降到了 0.2 美元"
 },
 {
  "i": 34,
  "start": 55.34,
  "end": 57.18,
  "text": "还有一点很多人都提到了"
 },
 {
  "i": 35,
  "start": 57.18,
  "end": 58.29,
  "text": "它更懂事了"
 },
 {
  "i": 36,
  "start": 58.34,
  "end": 59.66,
  "text": "默认就是会想得更深"
 },
 {
  "i": 37,
  "start": 59.66,
  "end": 61.18,
  "text": "写出来的计划几乎不用改"
 },
 {
  "i": 38,
  "start": 61.18,
  "end": 62.41,
  "text": "回答也更好读了"
 },
 {
  "i": 39,
  "start": 62.61,
  "end": 63.85,
  "text": "那怎么能用好它呢"
 },
 {
  "i": 40,
  "start": 63.85,
  "end": 65.72,
  "text": "给大家分享几个总结的技巧"
 },
 {
  "i": 41,
  "start": 65.89,
  "end": 66.93,
  "text": "第一个就是"
 },
 {
  "i": 42,
  "start": 66.93,
  "end": 69.4,
  "text": "别在提示词里面写请仔细思考"
 },
 {
  "i": 43,
  "start": 69.49,
  "end": 71.32,
  "text": "其实这只会让它思考更久"
 },
 {
  "i": 44,
  "start": 71.45,
  "end": 72.49,
  "text": "想让它多想的话"
 },
 {
  "i": 45,
  "start": 72.49,
  "end": 75.36,
  "text": "我们可以直接调这个 effort 的调节阀"
 },
 {
  "i": 46,
  "start": 75.62,
  "end": 77.49,
  "text": "第二 effort 并不是越高越好"
 },
 {
  "i": 47,
  "start": 77.53999999999999,
  "end": 79.85,
  "text": "默认的 medium 其实就已经很强了"
 },
 {
  "i": 48,
  "start": 79.98,
  "end": 81.22,
  "text": "然后有一些测试里面"
 },
 {
  "i": 49,
  "start": 81.22,
  "end": 83.28999999999999,
  "text": "medium 甚至比 high 和 max 还要好"
 },
 {
  "i": 50,
  "start": 83.5,
  "end": 84.82,
  "text": "长时间跑的 Agent 的任务"
 },
 {
  "i": 51,
  "start": 84.82,
  "end": 85.89,
  "text": "开到 high 就够了"
 },
 {
  "i": 52,
  "start": 86.02,
  "end": 87.89,
  "text": "max 很少能够值回票价"
 },
 {
  "i": 53,
  "start": 88.1,
  "end": 90.45,
  "text": "第三 以前为了防止它加戏"
 },
 {
  "i": 54,
  "start": 90.5,
  "end": 93.1,
  "text": "写的不要加我没要求的那些东西"
 },
 {
  "i": 55,
  "start": 93.1,
  "end": 94.85,
  "text": "现在就完全可以删掉了"
 },
 {
  "i": 56,
  "start": 94.94,
  "end": 97.81,
  "text": "第四个 给它一个检查自己的办法"
 },
 {
  "i": 57,
  "start": 98.05,
  "end": 99.49000000000001,
  "text": "比如一个能跑的测试"
 },
 {
  "i": 58,
  "start": 99.49000000000001,
  "end": 101.2,
  "text": "让它自己跑长任务的话"
 },
 {
  "i": 59,
  "start": 101.37,
  "end": 104.33,
  "text": "就是能够提前定好预算和停下来的点"
 },
 {
  "i": 60,
  "start": 104.33,
  "end": 106.33,
  "text": "OK 这就是本期视频的所有内容"
 },
 {
  "i": 61,
  "start": 106.33,
  "end": 107.47999999999999,
  "text": "我们下期再见"
 }
]
