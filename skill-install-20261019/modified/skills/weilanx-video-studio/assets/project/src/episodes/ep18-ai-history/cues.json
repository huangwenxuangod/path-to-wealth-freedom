[
 {
  "i": 1,
  "start": 0.43,
  "end": 1.7,
  "text": "1958 年 7 月"
 },
 {
  "i": 2,
  "start": 1.71,
  "end": 3.38,
  "text": "纽约时报 登了一条新闻"
 },
 {
  "i": 3,
  "start": 3.43,
  "end": 6.42,
  "text": "说美国海军展示了一台电子计算机的胚胎"
 },
 {
  "i": 4,
  "start": 6.55,
  "end": 8.39,
  "text": "将来它能走路、能说话"
 },
 {
  "i": 5,
  "start": 8.39,
  "end": 10.06,
  "text": "能看东西、能写字"
 },
 {
  "i": 6,
  "start": 10.07,
  "end": 11.74,
  "text": "甚至能意识到自己的存在"
 },
 {
  "i": 7,
  "start": 11.98,
  "end": 12.9,
  "text": "可这条预言"
 },
 {
  "i": 8,
  "start": 12.9,
  "end": 14.33,
  "text": "一等就是 60 多年"
 },
 {
  "i": 9,
  "start": 14.54,
  "end": 16.37,
  "text": "这中间到底发生了什么呢"
 },
 {
  "i": 10,
  "start": 16.42,
  "end": 19.13,
  "text": "这背后其实是一场吵了 70 年的争论"
 },
 {
  "i": 11,
  "start": 19.22,
  "end": 21.41,
  "text": "一派想把规则一条条教给机器"
 },
 {
  "i": 12,
  "start": 21.5,
  "end": 23.33,
  "text": "另一派想让机器自己去学"
 },
 {
  "i": 13,
  "start": 23.61,
  "end": 25.32,
  "text": "故事要从 1950 年说起"
 },
 {
  "i": 14,
  "start": 25.49,
  "end": 26.89,
  "text": "图灵发表了一篇论文"
 },
 {
  "i": 15,
  "start": 26.89,
  "end": 29.36,
  "text": "开头第一句就问 机器能思考吗"
 },
 {
  "i": 16,
  "start": 29.49,
  "end": 30.6,
  "text": "他没有直接回答"
 },
 {
  "i": 17,
  "start": 30.61,
  "end": 32,
  "text": "而是设计了一个游戏"
 },
 {
  "i": 18,
  "start": 32.09,
  "end": 33.8,
  "text": "如果你隔着屏幕跟它聊天"
 },
 {
  "i": 19,
  "start": 33.81,
  "end": 35.52,
  "text": "分不出它是人还是机器"
 },
 {
  "i": 20,
  "start": 35.53,
  "end": 36.96,
  "text": "那就可以说它在思考"
 },
 {
  "i": 21,
  "start": 37.21,
  "end": 37.92,
  "text": "5 年后"
 },
 {
  "i": 22,
  "start": 37.97,
  "end": 40.61,
  "text": "麦卡锡、明斯基、香农等四位科学家"
 },
 {
  "i": 23,
  "start": 40.61,
  "end": 41.56,
  "text": "写了一份提案"
 },
 {
  "i": 24,
  "start": 41.61,
  "end": 43.81,
  "text": "申请第二年夏天在达特茅斯学院"
 },
 {
  "i": 25,
  "start": 43.81,
  "end": 45.33,
  "text": "用两个月、10 个人"
 },
 {
  "i": 26,
  "start": 45.33,
  "end": 46.53,
  "text": "研究一门新学问"
 },
 {
  "i": 27,
  "start": 46.53,
  "end": 47.92,
  "text": "名字就叫人工智能"
 },
 {
  "i": 28,
  "start": 48.07,
  "end": 49.23,
  "text": "这是人工智能这个词"
 },
 {
  "i": 29,
  "start": 49.23,
  "end": 50.38,
  "text": "第一次被写下来"
 },
 {
  "i": 30,
  "start": 50.43,
  "end": 51.94,
  "text": "两派很快就分开了"
 },
 {
  "i": 31,
  "start": 51.95,
  "end": 54.06,
  "text": "规则派认为 智能就是逻辑"
 },
 {
  "i": 32,
  "start": 54.11,
  "end": 56.5,
  "text": "把知识写成规则 机器就能推理"
 },
 {
  "i": 33,
  "start": 56.55,
  "end": 57.95,
  "text": "学习派则模仿大脑"
 },
 {
  "i": 34,
  "start": 57.95,
  "end": 59.11,
  "text": "造出了感知机"
 },
 {
  "i": 35,
  "start": 59.11,
  "end": 60.98,
  "text": "也就是开头那条新闻里的胚胎"
 },
 {
  "i": 36,
  "start": 61.2,
  "end": 63.11,
  "text": "它能从例子里自己学会认图形"
 },
 {
  "i": 37,
  "start": 63.48,
  "end": 64.59,
  "text": "可好景不长"
 },
 {
  "i": 38,
  "start": 64.68,
  "end": 67,
  "text": "1969 年 明斯基写了一本书"
 },
 {
  "i": 39,
  "start": 67,
  "end": 68.64,
  "text": "证明这种简单的感知机"
 },
 {
  "i": 40,
  "start": 68.64,
  "end": 70.83,
  "text": "连一个很基础的逻辑问题都解决不了"
 },
 {
  "i": 41,
  "start": 70.88,
  "end": 72.83,
  "text": "学习派的经费一下子少了很多"
 },
 {
  "i": 42,
  "start": 73.15,
  "end": 75.27,
  "text": "4 年后 英国的一份报告又说"
 },
 {
  "i": 43,
  "start": 75.27,
  "end": 76.63,
  "text": "这个领域的任何发现"
 },
 {
  "i": 44,
  "start": 76.63,
  "end": 78.7,
  "text": "都没有带来当初承诺的重大影响"
 },
 {
  "i": 45,
  "start": 78.87,
  "end": 80.34,
  "text": "政府纷纷砍掉经费"
 },
 {
  "i": 46,
  "start": 80.35,
  "end": 82.22,
  "text": "人工智能迎来了第一次寒冬"
 },
 {
  "i": 47,
  "start": 82.31,
  "end": 83.38,
  "text": "到了 80 年代"
 },
 {
  "i": 48,
  "start": 83.39,
  "end": 85.7,
  "text": "规则派换了个思路 做专家系统"
 },
 {
  "i": 49,
  "start": 85.83,
  "end": 87.31,
  "text": "把医生、工程师的经验"
 },
 {
  "i": 50,
  "start": 87.31,
  "end": 88.86,
  "text": "写成成千上万条规则"
 },
 {
  "i": 51,
  "start": 88.95,
  "end": 90.03,
  "text": "到 1985 年"
 },
 {
  "i": 52,
  "start": 90.03,
  "end": 92.5,
  "text": "企业在上面的投入已经超过了 10 亿美元"
 },
 {
  "i": 53,
  "start": 92.59,
  "end": 93.87,
  "text": "但规则写得再多"
 },
 {
  "i": 54,
  "start": 93.87,
  "end": 95.5,
  "text": "遇到没见过的情况就出错"
 },
 {
  "i": 55,
  "start": 95.50999999999999,
  "end": 96.58,
  "text": "维护起来又贵"
 },
 {
  "i": 56,
  "start": 96.72999999999999,
  "end": 97.65,
  "text": "1987 年"
 },
 {
  "i": 57,
  "start": 97.65,
  "end": 99.77000000000001,
  "text": "专门跑这类程序的机器卖不动了"
 },
 {
  "i": 58,
  "start": 99.77000000000001,
  "end": 101.03999999999999,
  "text": "第二次寒冬来了"
 },
 {
  "i": 59,
  "start": 101.13,
  "end": 102.53,
  "text": "就在大家最冷的时候"
 },
 {
  "i": 60,
  "start": 102.53,
  "end": 104.28,
  "text": "学习派有人在悄悄干活"
 },
 {
  "i": 61,
  "start": 104.41,
  "end": 106.21000000000001,
  "text": "1986 年 辛顿和同事"
 },
 {
  "i": 62,
  "start": 106.21000000000001,
  "end": 108.68,
  "text": "在 自然 杂志上发表了反向传播的方法"
 },
 {
  "i": 63,
  "start": 108.84,
  "end": 109.88,
  "text": "让多层神经网络"
 },
 {
  "i": 64,
  "start": 109.88,
  "end": 111.67,
  "text": "可以一层层地修正自己的错误"
 },
 {
  "i": 65,
  "start": 111.72,
  "end": 113.75,
  "text": "这一招后来成了深度学习的地基"
 },
 {
  "i": 66,
  "start": 113.96000000000001,
  "end": 116.4,
  "text": "1997 年 规则派迎来了高光时刻"
 },
 {
  "i": 67,
  "start": 116.4,
  "end": 118.8,
  "text": "IBM 的深蓝以 3.5 比 2.5"
 },
 {
  "i": 68,
  "start": 118.8,
  "end": 121.23,
  "text": "击败了国际象棋世界冠军卡斯帕罗夫"
 },
 {
  "i": 69,
  "start": 121.46,
  "end": 122.73,
  "text": "可深蓝只会下棋"
 },
 {
  "i": 70,
  "start": 122.74,
  "end": 124.13,
  "text": "换个任务就什么也不会"
 },
 {
  "i": 71,
  "start": 124.26,
  "end": 125.93,
  "text": "真正的转折在 2012 年"
 },
 {
  "i": 72,
  "start": 126.02,
  "end": 127.1,
  "text": "辛顿的两个学生"
 },
 {
  "i": 73,
  "start": 127.1,
  "end": 129.5,
  "text": "用两块游戏显卡训练了一个神经网络"
 },
 {
  "i": 74,
  "start": 129.5,
  "end": 130.93,
  "text": "参加图片识别比赛"
 },
 {
  "i": 75,
  "start": 130.98,
  "end": 132.82,
  "text": "错误率从第二名的 26%"
 },
 {
  "i": 76,
  "start": 132.82,
  "end": 134.37,
  "text": "一下子降到了 15%"
 },
 {
  "i": 77,
  "start": 134.61,
  "end": 137.04,
  "text": "数据、算力和算法这三样东西"
 },
 {
  "i": 78,
  "start": 137.05,
  "end": 138.07999999999998,
  "text": "终于凑齐了"
 },
 {
  "i": 79,
  "start": 138.17000000000002,
  "end": 139.72,
  "text": "接下来的事情就快多了"
 },
 {
  "i": 80,
  "start": 139.77,
  "end": 142.44,
  "text": "2016 年 AlphaGo 4 比 1 击败李世石"
 },
 {
  "i": 81,
  "start": 142.61,
  "end": 144.12,
  "text": "全球超过 2 亿人在看"
 },
 {
  "i": 82,
  "start": 144.25,
  "end": 146.21,
  "text": "2017 年 谷歌的 8 位研究员"
 },
 {
  "i": 83,
  "start": 146.21,
  "end": 147.24,
  "text": "发表了一篇论文"
 },
 {
  "i": 84,
  "start": 147.25,
  "end": 149.12,
  "text": "提出了一种叫 Transformer 的结构"
 },
 {
  "i": 85,
  "start": 149.28,
  "end": 151.59,
  "text": "今天几乎所有的大模型都建在它上面"
 },
 {
  "i": 86,
  "start": 151.76,
  "end": 155.11,
  "text": "2020 年 GPT-3 有了 1750 亿个参数"
 },
 {
  "i": 87,
  "start": 155.24,
  "end": 157.44,
  "text": "2022 年底 ChatGPT 上线"
 },
 {
  "i": 88,
  "start": 157.44,
  "end": 158.51,
  "text": "据瑞银估计"
 },
 {
  "i": 89,
  "start": 158.52,
  "end": 159.95,
  "text": "两个月就有了 1 亿用户"
 },
 {
  "i": 90,
  "start": 160.21,
  "end": 161.04,
  "text": "2024 年"
 },
 {
  "i": 91,
  "start": 161.05,
  "end": 163.16,
  "text": "诺贝尔物理学奖颁给了辛顿等人"
 },
 {
  "i": 92,
  "start": 163.17000000000002,
  "end": 164.13,
  "text": "化学奖也颁给了"
 },
 {
  "i": 93,
  "start": 164.13,
  "end": 166.2,
  "text": "用 AI 预测蛋白质结构的科学家"
 },
 {
  "i": 94,
  "start": 166.32999999999998,
  "end": 168.4,
  "text": "当年坐了几十年冷板凳的学习派"
 },
 {
  "i": 95,
  "start": 168.45,
  "end": 170.12,
  "text": "终于站到了舞台的正中间"
 },
 {
  "i": 96,
  "start": 170.31,
  "end": 172.15,
  "text": "而到了今年 OpenAI 说"
 },
 {
  "i": 97,
  "start": 172.15,
  "end": 174.54,
  "text": "每周用 ChatGPT 的人已经超过了 10 亿"
 },
 {
  "i": 98,
  "start": 174.67000000000002,
  "end": 177.02,
  "text": "现在再回头看那条 1958 年的新闻"
 },
 {
  "i": 99,
  "start": 177.11,
  "end": 179.39,
  "text": "会说话、能看东西、会写字"
 },
 {
  "i": 100,
  "start": 179.39,
  "end": 180.9,
  "text": "这几条都已经实现了"
 },
 {
  "i": 101,
  "start": 181.04,
  "end": 182.47,
  "text": "至于意识到自己的存在"
 },
 {
  "i": 102,
  "start": 182.48,
  "end": 184.84,
  "text": "这个问题 可能还要再吵上很多年"
 },
 {
  "i": 103,
  "start": 184.84,
  "end": 186.92,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 104,
  "start": 186.92,
  "end": 187.99,
  "text": "我们下期再见"
 }
]
