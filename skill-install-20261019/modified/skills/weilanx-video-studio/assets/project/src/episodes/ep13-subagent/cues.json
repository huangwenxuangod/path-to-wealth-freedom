[
 {
  "i": 1,
  "start": 0.41,
  "end": 2.76,
  "text": "让一个 AI 帮你查十家公司的资料"
 },
 {
  "i": 2,
  "start": 2.81,
  "end": 4.12,
  "text": "它只能一家一家地查"
 },
 {
  "i": 3,
  "start": 4.21,
  "end": 5,
  "text": "查到后面"
 },
 {
  "i": 4,
  "start": 5.01,
  "end": 7,
  "text": "前面看过的内容都快被挤忘了"
 },
 {
  "i": 5,
  "start": 7.05,
  "end": 8.65,
  "text": "可如果它叫上几个帮手"
 },
 {
  "i": 6,
  "start": 8.65,
  "end": 10.6,
  "text": "每人分几家 同时开工"
 },
 {
  "i": 7,
  "start": 10.81,
  "end": 11.33,
  "text": "没过多久"
 },
 {
  "i": 8,
  "start": 11.33,
  "end": 13.8,
  "text": "就能把一份整理好的汇总交到你手上"
 },
 {
  "i": 9,
  "start": 13.89,
  "end": 15.12,
  "text": "这种干活的方式"
 },
 {
  "i": 10,
  "start": 15.13,
  "end": 16.12,
  "text": "叫做子 Agent"
 },
 {
  "i": 11,
  "start": 16.25,
  "end": 17.56,
  "text": "也有人叫它多 Agent"
 },
 {
  "i": 12,
  "start": 17.81,
  "end": 18.92,
  "text": "我们之前讲过"
 },
 {
  "i": 13,
  "start": 19.09,
  "end": 20.8,
  "text": "Agent 就是会自己用工具"
 },
 {
  "i": 14,
  "start": 20.81,
  "end": 22.56,
  "text": "一步步把事做完的 AI"
 },
 {
  "i": 15,
  "start": 22.65,
  "end": 24.48,
  "text": "子 Agent 就是由一个总管 Agent"
 },
 {
  "i": 16,
  "start": 24.53,
  "end": 26.09,
  "text": "先把大任务拆成几块"
 },
 {
  "i": 17,
  "start": 26.09,
  "end": 27.76,
  "text": "再分派给几个帮手去做"
 },
 {
  "i": 18,
  "start": 27.85,
  "end": 28.85,
  "text": "每个帮手做完"
 },
 {
  "i": 19,
  "start": 28.85,
  "end": 30.44,
  "text": "只把要点交回给总管"
 },
 {
  "i": 20,
  "start": 30.49,
  "end": 32.4,
  "text": "最后由总管汇总成一份结果"
 },
 {
  "i": 21,
  "start": 32.58,
  "end": 34.13,
  "text": "这样做主要有两个好处"
 },
 {
  "i": 22,
  "start": 34.18,
  "end": 35.09,
  "text": "第一是快"
 },
 {
  "i": 23,
  "start": 35.1,
  "end": 36.9,
  "text": "因为几个帮手是同时干活的"
 },
 {
  "i": 24,
  "start": 36.9,
  "end": 38.41,
  "text": "不用排队一件一件来"
 },
 {
  "i": 25,
  "start": 38.5,
  "end": 39.57,
  "text": "第二个更关键"
 },
 {
  "i": 26,
  "start": 39.66,
  "end": 40.78,
  "text": "还记得我们说过"
 },
 {
  "i": 27,
  "start": 40.78,
  "end": 42.73,
  "text": "上下文就是 AI 的办公桌吗"
 },
 {
  "i": 28,
  "start": 42.84,
  "end": 44.59,
  "text": "每个帮手都有一张自己的桌子"
 },
 {
  "i": 29,
  "start": 44.64,
  "end": 46.4,
  "text": "查资料翻出来的一大堆东西"
 },
 {
  "i": 30,
  "start": 46.4,
  "end": 47.83,
  "text": "都堆在它们自己桌上"
 },
 {
  "i": 31,
  "start": 47.84,
  "end": 49.75,
  "text": "交回给总管的只有几句结论"
 },
 {
  "i": 32,
  "start": 49.76,
  "end": 52.19,
  "text": "这样一来 总管的桌面就一直很干净"
 },
 {
  "i": 33,
  "start": 52.24,
  "end": 53.27,
  "text": "脑子也更清楚"
 },
 {
  "i": 34,
  "start": 53.56,
  "end": 55.56,
  "text": "不过帮手多了 花的钱也会多"
 },
 {
  "i": 35,
  "start": 55.56,
  "end": 57.43,
  "text": "Anthropic 公开分享过"
 },
 {
  "i": 36,
  "start": 57.44,
  "end": 59.35,
  "text": "他们做调研用的多 Agent 系统"
 },
 {
  "i": 37,
  "start": 59.36,
  "end": 60.16,
  "text": "消耗的 token"
 },
 {
  "i": 38,
  "start": 60.16,
  "end": 61.75,
  "text": "大约是普通聊天的十五倍"
 },
 {
  "i": 39,
  "start": 61.84,
  "end": 63.2,
  "text": "那平时该怎么用呢"
 },
 {
  "i": 40,
  "start": 63.2,
  "end": 64.51,
  "text": "这里分享三个建议"
 },
 {
  "i": 41,
  "start": 64.76,
  "end": 67.07,
  "text": "第一 只把能拆开的活交给帮手"
 },
 {
  "i": 42,
  "start": 67.2,
  "end": 69.83,
  "text": "比如同时查几份资料、同时看几个文件"
 },
 {
  "i": 43,
  "start": 69.88,
  "end": 71.59,
  "text": "这种互不影响的活最合适"
 },
 {
  "i": 44,
  "start": 71.6,
  "end": 73.71000000000001,
  "text": "而像写一篇前后要连贯的文章"
 },
 {
  "i": 45,
  "start": 73.72,
  "end": 75.75,
  "text": "还是让一个 AI 从头写到尾更好"
 },
 {
  "i": 46,
  "start": 75.97,
  "end": 78.28,
  "text": "第二 给每个帮手的任务交代清楚"
 },
 {
  "i": 47,
  "start": 78.33,
  "end": 80.69,
  "text": "因为帮手看不到你和总管前面聊过什么"
 },
 {
  "i": 48,
  "start": 80.69,
  "end": 82.56,
  "text": "要查什么、查到什么程度"
 },
 {
  "i": 49,
  "start": 82.57,
  "end": 83.81,
  "text": "最后交回什么格式"
 },
 {
  "i": 50,
  "start": 83.81,
  "end": 85.56,
  "text": "都得在派活的时候写明白"
 },
 {
  "i": 51,
  "start": 85.83,
  "end": 87.67,
  "text": "第三 小活就别叫帮手了"
 },
 {
  "i": 52,
  "start": 87.67,
  "end": 89.07,
  "text": "一两步就能做完的事"
 },
 {
  "i": 53,
  "start": 89.07,
  "end": 90.98,
  "text": "拆开反而更慢、更费 token"
 },
 {
  "i": 54,
  "start": 91.07,
  "end": 92.63,
  "text": "而且帮手交回来的结果"
 },
 {
  "i": 55,
  "start": 92.63,
  "end": 94.47,
  "text": "关键的地方最好自己再看一遍"
 },
 {
  "i": 56,
  "start": 94.47,
  "end": 96.35,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 57,
  "start": 96.35,
  "end": 97.34,
  "text": "我们下期再见"
 }
]
