[
 {
  "i": 1,
  "start": 0.34,
  "end": 2.21,
  "text": "就在你听我说这句话的这一秒"
 },
 {
  "i": 2,
  "start": 2.22,
  "end": 3.78,
  "text": "已经有 650 亿个粒子"
 },
 {
  "i": 3,
  "start": 3.78,
  "end": 5.09,
  "text": "穿过了你的小指甲盖"
 },
 {
  "i": 4,
  "start": 5.34,
  "end": 7.09,
  "text": "你一点感觉都没有 对吧"
 },
 {
  "i": 5,
  "start": 7.18,
  "end": 8.78,
  "text": "可今年的诺贝尔物理学奖"
 },
 {
  "i": 6,
  "start": 8.78,
  "end": 10.41,
  "text": "偏偏颁给了一个抓住它们的人"
 },
 {
  "i": 7,
  "start": 10.53,
  "end": 11.81,
  "text": "这种粒子叫中微子"
 },
 {
  "i": 8,
  "start": 11.81,
  "end": 13.45,
  "text": "不带电 几乎没有质量"
 },
 {
  "i": 9,
  "start": 13.45,
  "end": 15.13,
  "text": "连整个地球都能一穿而过"
 },
 {
  "i": 10,
  "start": 15.13,
  "end": 16.68,
  "text": "所以也被叫作幽灵粒子"
 },
 {
  "i": 11,
  "start": 16.77,
  "end": 18.16,
  "text": "那怎么抓一个幽灵呢"
 },
 {
  "i": 12,
  "start": 18.25,
  "end": 20.88,
  "text": "1988 年 弗朗西斯·哈尔岑想到了南极"
 },
 {
  "i": 13,
  "start": 21.26,
  "end": 22.69,
  "text": "那里的冰又深又透明"
 },
 {
  "i": 14,
  "start": 22.78,
  "end": 24.25,
  "text": "中微子偶尔撞上原子核"
 },
 {
  "i": 15,
  "start": 24.26,
  "end": 25.81,
  "text": "会闪出一道微弱的蓝光"
 },
 {
  "i": 16,
  "start": 25.86,
  "end": 27.58,
  "text": "只要在冰里埋下足够多的眼睛"
 },
 {
  "i": 17,
  "start": 27.58,
  "end": 28.69,
  "text": "就能把它拍下来"
 },
 {
  "i": 18,
  "start": 28.82,
  "end": 30.93,
  "text": "听起来很疯狂 可他们真干了"
 },
 {
  "i": 19,
  "start": 31.18,
  "end": 32.94,
  "text": "在冰盖上钻出 86 个深洞"
 },
 {
  "i": 20,
  "start": 32.94,
  "end": 35.69,
  "text": "把 5160 个探测器放进冰下两千多米"
 },
 {
  "i": 21,
  "start": 35.74,
  "end": 36.98,
  "text": "一整立方公里的冰"
 },
 {
  "i": 22,
  "start": 36.98,
  "end": 39.21,
  "text": "就这样变成了望远镜 叫冰立方"
 },
 {
  "i": 23,
  "start": 39.38,
  "end": 42.49,
  "text": "2013 年 它抓到了来自太阳系外的高能中微子"
 },
 {
  "i": 24,
  "start": 42.66,
  "end": 44.14,
  "text": "2017 年 一个中微子"
 },
 {
  "i": 25,
  "start": 44.14,
  "end": 46.02,
  "text": "还把科学家指向了 40 亿光年外"
 },
 {
  "i": 26,
  "start": 46.02,
  "end": 47.61,
  "text": "一个藏着巨型黑洞的星系"
 },
 {
  "i": 27,
  "start": 47.78,
  "end": 49.34,
  "text": "你想啊 人类看宇宙"
 },
 {
  "i": 28,
  "start": 49.34,
  "end": 50.9,
  "text": "几百年来靠的几乎都是光"
 },
 {
  "i": 29,
  "start": 50.9,
  "end": 52.25,
  "text": "可光会被尘埃挡住"
 },
 {
  "i": 30,
  "start": 52.3,
  "end": 53.17,
  "text": "中微子不会"
 },
 {
  "i": 31,
  "start": 53.34,
  "end": 54.66,
  "text": "它不拐弯 也不停下"
 },
 {
  "i": 32,
  "start": 54.66,
  "end": 56.45,
  "text": "一路笔直地飞进南极的冰里"
 },
 {
  "i": 33,
  "start": 56.46,
  "end": 57.58,
  "text": "所以这个诺奖奖励的"
 },
 {
  "i": 34,
  "start": 57.58,
  "end": 58.5,
  "text": "不只是一台仪器"
 },
 {
  "i": 35,
  "start": 58.5,
  "end": 59.58,
  "text": "而是人类看宇宙"
 },
 {
  "i": 36,
  "start": 59.58,
  "end": 60.97,
  "text": "多了一双不靠光的眼睛"
 }
]
