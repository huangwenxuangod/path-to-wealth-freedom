[
 {
  "i": 1,
  "start": 0.43,
  "end": 1.23,
  "text": "你有没有发现"
 },
 {
  "i": 2,
  "start": 1.23,
  "end": 3.06,
  "text": "AI 聊着聊着就变笨了"
 },
 {
  "i": 3,
  "start": 3.07,
  "end": 4.15,
  "text": "前面答应好的要求"
 },
 {
  "i": 4,
  "start": 4.15,
  "end": 5.23,
  "text": "到后面全忘了"
 },
 {
  "i": 5,
  "start": 5.23,
  "end": 6.58,
  "text": "可你新开一个对话"
 },
 {
  "i": 6,
  "start": 6.59,
  "end": 7.94,
  "text": "它又突然变聪明了"
 },
 {
  "i": 7,
  "start": 7.99,
  "end": 9.03,
  "text": "这背后的原因"
 },
 {
  "i": 8,
  "start": 9.03,
  "end": 11.54,
  "text": "就藏在大模型一个特别重要的概念里"
 },
 {
  "i": 9,
  "start": 11.68,
  "end": 13.63,
  "text": "叫做上下文 也就是 context"
 },
 {
  "i": 10,
  "start": 13.84,
  "end": 14.6,
  "text": "搞懂了它"
 },
 {
  "i": 11,
  "start": 14.6,
  "end": 16.55,
  "text": "你用 AI 的效果会好很多"
 },
 {
  "i": 12,
  "start": 16.72,
  "end": 17.72,
  "text": "所谓上下文"
 },
 {
  "i": 13,
  "start": 17.72,
  "end": 19.08,
  "text": "就是模型回答你的时候"
 },
 {
  "i": 14,
  "start": 19.08,
  "end": 20.47,
  "text": "能看到的全部内容"
 },
 {
  "i": 15,
  "start": 20.6,
  "end": 22.63,
  "text": "其实模型本身什么都不记得"
 },
 {
  "i": 16,
  "start": 22.85,
  "end": 24.05,
  "text": "它每次回答你之前"
 },
 {
  "i": 17,
  "start": 24.05,
  "end": 25.36,
  "text": "都要把你发的消息"
 },
 {
  "i": 18,
  "start": 25.53,
  "end": 26.49,
  "text": "它之前的回答"
 },
 {
  "i": 19,
  "start": 26.49,
  "end": 28.24,
  "text": "你上传的文件拼在一起"
 },
 {
  "i": 20,
  "start": 28.29,
  "end": 29.88,
  "text": "从头到尾重新读一遍"
 },
 {
  "i": 21,
  "start": 29.97,
  "end": 31.92,
  "text": "你可以把它想象成一张办公桌"
 },
 {
  "i": 22,
  "start": 31.97,
  "end": 33.08,
  "text": "桌上摆着什么"
 },
 {
  "i": 23,
  "start": 33.13,
  "end": 34.32,
  "text": "它就只能看到什么"
 },
 {
  "i": 24,
  "start": 34.53,
  "end": 37,
  "text": "这张桌子的大小就叫上下文窗口"
 },
 {
  "i": 25,
  "start": 37.09,
  "end": 38.01,
  "text": "现在有些模型"
 },
 {
  "i": 26,
  "start": 38.01,
  "end": 39.64,
  "text": "已经能放下一百万个 token"
 },
 {
  "i": 27,
  "start": 39.81,
  "end": 41.41,
  "text": "差不多是好几本书的量"
 },
 {
  "i": 28,
  "start": 41.41,
  "end": 42.96,
  "text": "但桌子再大也有边"
 },
 {
  "i": 29,
  "start": 43.01,
  "end": 43.89,
  "text": "放满了以后"
 },
 {
  "i": 30,
  "start": 43.89,
  "end": 45.52,
  "text": "前面的内容就会被压缩"
 },
 {
  "i": 31,
  "start": 45.53,
  "end": 46.8,
  "text": "或者直接挪出去"
 },
 {
  "i": 32,
  "start": 47.02,
  "end": 48.3,
  "text": "而且东西放得越多"
 },
 {
  "i": 33,
  "start": 48.3,
  "end": 49.89,
  "text": "也不代表它看得越清楚"
 },
 {
  "i": 34,
  "start": 49.98,
  "end": 51.01,
  "text": "有研究发现"
 },
 {
  "i": 35,
  "start": 51.1,
  "end": 53.69,
  "text": "重要的信息如果埋在一大堆内容的中间"
 },
 {
  "i": 36,
  "start": 53.74,
  "end": 55.65,
  "text": "模型反而更容易把它忽略掉"
 },
 {
  "i": 37,
  "start": 55.66,
  "end": 57.81,
  "text": "这也是它聊久了会变笨的一个原因"
 },
 {
  "i": 38,
  "start": 58.06,
  "end": 59.26,
  "text": "所以用好上下文"
 },
 {
  "i": 39,
  "start": 59.26,
  "end": 60.89,
  "text": "其实就是管好这张桌子"
 },
 {
  "i": 40,
  "start": 60.94,
  "end": 62.37,
  "text": "这里分享三个做法"
 },
 {
  "i": 41,
  "start": 62.5,
  "end": 65.01,
  "text": "第一 把它需要的东西主动放上去"
 },
 {
  "i": 42,
  "start": 65.06,
  "end": 66.46,
  "text": "比如让它帮你改文案"
 },
 {
  "i": 43,
  "start": 66.46,
  "end": 68.46000000000001,
  "text": "就把目标读者 想要的风格"
 },
 {
  "i": 44,
  "start": 68.46000000000001,
  "end": 70.53,
  "text": "和一段你满意的例子一起发给它"
 },
 {
  "i": 45,
  "start": 70.8,
  "end": 72.78999999999999,
  "text": "因为它不会去猜你心里在想什么"
 },
 {
  "i": 46,
  "start": 72.96000000000001,
  "end": 75.03,
  "text": "第二 一个对话只做一件事"
 },
 {
  "i": 47,
  "start": 75.03999999999999,
  "end": 76.87,
  "text": "换了新任务就开个新对话"
 },
 {
  "i": 48,
  "start": 76.92,
  "end": 78.78999999999999,
  "text": "这样它就不会被旧内容带偏"
 },
 {
  "i": 49,
  "start": 79,
  "end": 80.72,
  "text": "第三 聊得很长的时候"
 },
 {
  "i": 50,
  "start": 80.72,
  "end": 82.47,
  "text": "先让它帮你总结一下要点"
 },
 {
  "i": 51,
  "start": 82.63,
  "end": 84.53999999999999,
  "text": "再带着这份总结去开新对话"
 },
 {
  "i": 52,
  "start": 84.55,
  "end": 86.11,
  "text": "相当于把桌子收拾干净"
 },
 {
  "i": 53,
  "start": 86.11,
  "end": 87.78999999999999,
  "text": "只留下最重要的几样东西"
 },
 {
  "i": 54,
  "start": 87.78999999999999,
  "end": 89.87,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 55,
  "start": 89.87,
  "end": 90.9,
  "text": "我们下期再见"
 }
]
