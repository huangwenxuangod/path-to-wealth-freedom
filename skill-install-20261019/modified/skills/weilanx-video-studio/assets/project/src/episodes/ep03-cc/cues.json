[
 {
  "i": 1,
  "start": 0.5,
  "end": 2.57,
  "text": "Hello 各位今天我们来分享一下"
 },
 {
  "i": 2,
  "start": 2.58,
  "end": 3.9,
  "text": "怎么用 CC 做出这种"
 },
 {
  "i": 3,
  "start": 3.9,
  "end": 5.69,
  "text": "手绘风的动画口播视频"
 },
 {
  "i": 4,
  "start": 5.9,
  "end": 7.38,
  "text": "前两期视频里大家看到的"
 },
 {
  "i": 5,
  "start": 7.38,
  "end": 9.25,
  "text": "橙色小人、弹出来的卡片"
 },
 {
  "i": 6,
  "start": 9.26,
  "end": 10.45,
  "text": "背景音乐和音效"
 },
 {
  "i": 7,
  "start": 10.46,
  "end": 12.45,
  "text": "全部都是 CC 写代码做出来的"
 },
 {
  "i": 8,
  "start": 12.69,
  "end": 13.33,
  "text": "开始之前"
 },
 {
  "i": 9,
  "start": 13.33,
  "end": 15.76,
  "text": "我们先想清楚这种视频的本质是什么"
 },
 {
  "i": 10,
  "start": 15.85,
  "end": 17.08,
  "text": "其实它就两件事"
 },
 {
  "i": 11,
  "start": 17.13,
  "end": 17.88,
  "text": "第一件事"
 },
 {
  "i": 12,
  "start": 17.89,
  "end": 19.49,
  "text": "画面是用代码画出来的"
 },
 {
  "i": 13,
  "start": 19.49,
  "end": 21.04,
  "text": "这里用到的工具叫 Remotion"
 },
 {
  "i": 14,
  "start": 21.33,
  "end": 23.36,
  "text": "它可以把视频当成一个网页来写"
 },
 {
  "i": 15,
  "start": 23.48,
  "end": 24.83,
  "text": "你告诉它现在是第几帧"
 },
 {
  "i": 16,
  "start": 24.92,
  "end": 26.52,
  "text": "它就算出这一帧该画什么"
 },
 {
  "i": 17,
  "start": 26.52,
  "end": 27.92,
  "text": "比如这张卡片放多大"
 },
 {
  "i": 18,
  "start": 27.92,
  "end": 28.99,
  "text": "小人站在哪"
 },
 {
  "i": 19,
  "start": 29.08,
  "end": 29.95,
  "text": "导出的时候"
 },
 {
  "i": 20,
  "start": 29.96,
  "end": 31.16,
  "text": "它会打开一个浏览器"
 },
 {
  "i": 21,
  "start": 31.16,
  "end": 32.28,
  "text": "一帧一帧截图"
 },
 {
  "i": 22,
  "start": 32.28,
  "end": 33.67,
  "text": "最后拼成一个 MP4"
 },
 {
  "i": 23,
  "start": 33.84,
  "end": 35.08,
  "text": "所以对 CC 来说"
 },
 {
  "i": 24,
  "start": 35.08,
  "end": 36.75,
  "text": "做动画其实就是写代码"
 },
 {
  "i": 25,
  "start": 36.88,
  "end": 37.67,
  "text": "第二件事"
 },
 {
  "i": 26,
  "start": 37.72,
  "end": 39.24,
  "text": "所有动画都跟着字幕走"
 },
 {
  "i": 27,
  "start": 39.24,
  "end": 40.96,
  "text": "我们录完口播、剪好之后"
 },
 {
  "i": 28,
  "start": 40.96,
  "end": 42.16,
  "text": "会导出一段纯人声"
 },
 {
  "i": 29,
  "start": 42.16,
  "end": 43.51,
  "text": "和一份 SRT 字幕"
 },
 {
  "i": 30,
  "start": 43.82,
  "end": 44.58,
  "text": "字幕里每一句话"
 },
 {
  "i": 31,
  "start": 44.58,
  "end": 46.02,
  "text": "都有开始和结束的时间"
 },
 {
  "i": 32,
  "start": 46.02,
  "end": 48.02,
  "text": "CC 会先把这份字幕读进来"
 },
 {
  "i": 33,
  "start": 48.02,
  "end": 49.22,
  "text": "转成一张时间表"
 },
 {
  "i": 34,
  "start": 49.22,
  "end": 50.46,
  "text": "然后把每个动画挂在"
 },
 {
  "i": 35,
  "start": 50.46,
  "end": 52.21,
  "text": "第几句话、说到哪个词上"
 },
 {
  "i": 36,
  "start": 52.26,
  "end": 54.53,
  "text": "比如口播说到读取文件的那一刻"
 },
 {
  "i": 37,
  "start": 54.58,
  "end": 56.53,
  "text": "读取文件的卡片就刚好弹出来"
 },
 {
  "i": 38,
  "start": 56.73,
  "end": 57.93,
  "text": "以后你重录了口播"
 },
 {
  "i": 39,
  "start": 57.93,
  "end": 59.73,
  "text": "只要换一份字幕重新导出"
 },
 {
  "i": 40,
  "start": 59.73,
  "end": 61.56,
  "text": "动画就会自动对上新的节奏"
 },
 {
  "i": 41,
  "start": 61.69,
  "end": 62.73,
  "text": "想清楚这两点"
 },
 {
  "i": 42,
  "start": 62.73,
  "end": 63.93,
  "text": "做起来就很简单了"
 },
 {
  "i": 43,
  "start": 63.93,
  "end": 64.97,
  "text": "我们打开 CC"
 },
 {
  "i": 44,
  "start": 64.97,
  "end": 67.2,
  "text": "把人声文件和字幕文件的路径发给它"
 },
 {
  "i": 45,
  "start": 67.25,
  "end": 69.08,
  "text": "告诉它想做一个什么风格的视频"
 },
 {
  "i": 46,
  "start": 69.34,
  "end": 70.66,
  "text": "如果手上有参考视频"
 },
 {
  "i": 47,
  "start": 70.66,
  "end": 71.73,
  "text": "也可以一起发给它"
 },
 {
  "i": 48,
  "start": 71.82,
  "end": 73.7,
  "text": "我第一次就是直接丢了一个参考视频"
 },
 {
  "i": 49,
  "start": 73.7,
  "end": 74.73,
  "text": "问它能不能做"
 },
 {
  "i": 50,
  "start": 74.82,
  "end": 76.37,
  "text": "它会先问你几个关键问题"
 },
 {
  "i": 51,
  "start": 76.42,
  "end": 77.5,
  "text": "横屏还是竖屏"
 },
 {
  "i": 52,
  "start": 77.5,
  "end": 78.65,
  "text": "要不要烧录字幕"
 },
 {
  "i": 53,
  "start": 78.66,
  "end": 79.69,
  "text": "最后交付什么"
 },
 {
  "i": 54,
  "start": 79.81,
  "end": 81.21000000000001,
  "text": "然后它会出一份分镜表"
 },
 {
  "i": 55,
  "start": 81.21000000000001,
  "end": 82.45,
  "text": "每几句话一个场景"
 },
 {
  "i": 56,
  "start": 82.45,
  "end": 84.25,
  "text": "写清楚这一段画面里演什么"
 },
 {
  "i": 57,
  "start": 84.25,
  "end": 85.01,
  "text": "你看一下"
 },
 {
  "i": 58,
  "start": 85.01,
  "end": 86.56,
  "text": "觉得哪里不对就直接说"
 },
 {
  "i": 59,
  "start": 86.65,
  "end": 87.37,
  "text": "确认之后"
 },
 {
  "i": 60,
  "start": 87.37,
  "end": 88.44,
  "text": "它就开始写代码"
 },
 {
  "i": 61,
  "start": 88.57,
  "end": 90.89,
  "text": "场景、小人、图标、字幕条"
 },
 {
  "i": 62,
  "start": 90.89,
  "end": 92,
  "text": "都是代码画的"
 },
 {
  "i": 63,
  "start": 92.07,
  "end": 93.83,
  "text": "背景音乐也是它用代码合成的"
 },
 {
  "i": 64,
  "start": 93.83,
  "end": 95.22,
  "text": "所以不存在版权问题"
 },
 {
  "i": 65,
  "start": 95.22999999999999,
  "end": 96.22999999999999,
  "text": "而且有人声的时候"
 },
 {
  "i": 66,
  "start": 96.22999999999999,
  "end": 97.53999999999999,
  "text": "会自动把音乐压低"
 },
 {
  "i": 67,
  "start": 97.59,
  "end": 98.35,
  "text": "写完之后"
 },
 {
  "i": 68,
  "start": 98.35,
  "end": 100.07,
  "text": "它会帮你打开 Remotion Studio"
 },
 {
  "i": 69,
  "start": 100.07,
  "end": 102.3,
  "text": "这是一个在浏览器里运行的预览界面"
 },
 {
  "i": 70,
  "start": 102.31,
  "end": 104.19,
  "text": "你可以拖动时间轴一帧一帧看"
 },
 {
  "i": 71,
  "start": 104.19,
  "end": 105.7,
  "text": "也能直接播放听声音"
 },
 {
  "i": 72,
  "start": 105.88,
  "end": 106.68,
  "text": "觉得哪里不满意"
 },
 {
  "i": 73,
  "start": 106.68,
  "end": 107.50999999999999,
  "text": "就跟它说"
 },
 {
  "i": 74,
  "start": 107.52000000000001,
  "end": 109,
  "text": "比如我上一期就提了几点"
 },
 {
  "i": 75,
  "start": 109,
  "end": 110.08,
  "text": "背景音乐太重了"
 },
 {
  "i": 76,
  "start": 110.08,
  "end": 111.44,
  "text": "小人的眼睛再大一点"
 },
 {
  "i": 77,
  "start": 111.44,
  "end": 113.75999999999999,
  "text": "再给它加点圣诞帽、耳机、太空服"
 },
 {
  "i": 78,
  "start": 113.75999999999999,
  "end": 114.47,
  "text": "这样的配饰"
 },
 {
  "i": 79,
  "start": 114.52000000000001,
  "end": 115.78999999999999,
  "text": "画面也再丰富一点"
 },
 {
  "i": 80,
  "start": 115.99000000000001,
  "end": 116.55,
  "text": "它改完"
 },
 {
  "i": 81,
  "start": 116.55,
  "end": 117.74000000000001,
  "text": "页面会自动刷新"
 },
 {
  "i": 82,
  "start": 117.75,
  "end": 118.94,
  "text": "马上就能看到效果"
 },
 {
  "i": 83,
  "start": 119.03,
  "end": 120.27,
  "text": "这里有一点要提醒大家"
 },
 {
  "i": 84,
  "start": 120.27,
  "end": 121.94,
  "text": "CC 是听不到声音的"
 },
 {
  "i": 85,
  "start": 121.95,
  "end": 123.23,
  "text": "它能检查音量数值"
 },
 {
  "i": 86,
  "start": 123.23,
  "end": 124.59,
  "text": "但背景音乐好不好听"
 },
 {
  "i": 87,
  "start": 124.59,
  "end": 125.39,
  "text": "音效吵不吵"
 },
 {
  "i": 88,
  "start": 125.39,
  "end": 127.18,
  "text": "还得我们自己戴上耳机听一遍"
 },
 {
  "i": 89,
  "start": 127.34,
  "end": 128.3,
  "text": "最后确认没问题了"
 },
 {
  "i": 90,
  "start": 128.3,
  "end": 129.29,
  "text": "就让它导出"
 },
 {
  "i": 91,
  "start": 129.34,
  "end": 130.29,
  "text": "一分钟的视频"
 },
 {
  "i": 92,
  "start": 130.34,
  "end": 131.89,
  "text": "渲染大概也就一分钟左右"
 },
 {
  "i": 93,
  "start": 132.02,
  "end": 133.21,
  "text": "它会给你一个成片"
 },
 {
  "i": 94,
  "start": 133.22,
  "end": 135.18,
  "text": "另外还有人声、背景音乐、音效"
 },
 {
  "i": 95,
  "start": 135.18,
  "end": 135.9,
  "text": "三条分轨"
 },
 {
  "i": 96,
  "start": 135.9,
  "end": 137.54,
  "text": "你想在剪辑软件里再调音量"
 },
 {
  "i": 97,
  "start": 137.54,
  "end": 138.25,
  "text": "也很方便"
 },
 {
  "i": 98,
  "start": 138.44,
  "end": 139.16,
  "text": "做完这几期"
 },
 {
  "i": 99,
  "start": 139.16,
  "end": 141.27,
  "text": "我最大的感受是分工变清楚了"
 },
 {
  "i": 100,
  "start": 141.28,
  "end": 142.64,
  "text": "选题、口播内容"
 },
 {
  "i": 101,
  "start": 142.64,
  "end": 144.52,
  "text": "还有好不好看、好不好听的判断"
 },
 {
  "i": 102,
  "start": 144.52,
  "end": 145.8,
  "text": "这些是我来负责的"
 },
 {
  "i": 103,
  "start": 145.8,
  "end": 147.36,
  "text": "画面怎么画、代码怎么写"
 },
 {
  "i": 104,
  "start": 147.36,
  "end": 148.36,
  "text": "就交给 CC"
 },
 {
  "i": 105,
  "start": 148.36,
  "end": 150.16,
  "text": "给它提意见的时候越具体越好"
 },
 {
  "i": 106,
  "start": 150.16,
  "end": 151.28,
  "text": "背景音乐再小一点"
 },
 {
  "i": 107,
  "start": 151.28,
  "end": 153.03,
  "text": "比感觉不太对好改得多"
 },
 {
  "i": 108,
  "start": 153.17000000000002,
  "end": 154.49,
  "text": "如果大家想自己试一试"
 },
 {
  "i": 109,
  "start": 154.49,
  "end": 156.64,
  "text": "建议先从一分钟左右的短视频开始"
 },
 {
  "i": 110,
  "start": 156.77,
  "end": 158.53,
  "text": "另外我把第一版三十秒的 demo"
 },
 {
  "i": 111,
  "start": 158.53,
  "end": 159.69,
  "text": "开源到了 GitHub 上"
 },
 {
  "i": 112,
  "start": 159.69,
  "end": 160.89,
  "text": "项目叫 doodle-cut"
 },
 {
  "i": 113,
  "start": 160.89,
  "end": 162.09,
  "text": "大家可以直接拿来改"
 },
 {
  "i": 114,
  "start": 162.09,
  "end": 163.73,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 115,
  "start": 163.73,
  "end": 164.68,
  "text": "我们下期再见"
 }
]
