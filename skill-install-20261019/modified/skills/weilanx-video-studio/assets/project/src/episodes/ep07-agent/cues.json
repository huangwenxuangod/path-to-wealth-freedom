[
 {
  "i": 1,
  "start": 0.37,
  "end": 2.32,
  "text": "我这几期动画视频里的画面"
 },
 {
  "i": 2,
  "start": 2.33,
  "end": 3.45,
  "text": "配乐和音效"
 },
 {
  "i": 3,
  "start": 3.45,
  "end": 5.21,
  "text": "都不是我一笔一笔做出来的"
 },
 {
  "i": 4,
  "start": 5.21,
  "end": 6.93,
  "text": "而是一个 AI 自己写代码"
 },
 {
  "i": 5,
  "start": 6.93,
  "end": 8.28,
  "text": "自己渲染出来检查"
 },
 {
  "i": 6,
  "start": 8.33,
  "end": 9.93,
  "text": "发现不对再自己改好的"
 },
 {
  "i": 7,
  "start": 9.93,
  "end": 11.96,
  "text": "我只负责提需求和最后把关"
 },
 {
  "i": 8,
  "start": 12.35,
  "end": 13.62,
  "text": "能做到这一步的 AI"
 },
 {
  "i": 9,
  "start": 13.63,
  "end": 15.58,
  "text": "有一个专门的名字 叫做 Agent"
 },
 {
  "i": 10,
  "start": 16.11,
  "end": 18.11,
  "text": "那 Agent 和我们平时用的聊天 AI"
 },
 {
  "i": 11,
  "start": 18.11,
  "end": 19.22,
  "text": "到底差在哪呢"
 },
 {
  "i": 12,
  "start": 19.27,
  "end": 21.22,
  "text": "我们拿一件小事来对比一下"
 },
 {
  "i": 13,
  "start": 21.39,
  "end": 22.83,
  "text": "比如你想把电脑桌面上"
 },
 {
  "i": 14,
  "start": 22.83,
  "end": 24.42,
  "text": "乱七八糟的文件整理好"
 },
 {
  "i": 15,
  "start": 24.5,
  "end": 25.78,
  "text": "你去问聊天 AI"
 },
 {
  "i": 16,
  "start": 25.78,
  "end": 26.9,
  "text": "它会很认真地告诉你"
 },
 {
  "i": 17,
  "start": 26.9,
  "end": 28.77,
  "text": "第一步做什么 第二步做什么"
 },
 {
  "i": 18,
  "start": 28.78,
  "end": 30.57,
  "text": "但真正动手的还是你自己"
 },
 {
  "i": 19,
  "start": 30.66,
  "end": 32.21,
  "text": "可同样一句话交给 Agent"
 },
 {
  "i": 20,
  "start": 32.42,
  "end": 33.66,
  "text": "它会自己打开文件夹"
 },
 {
  "i": 21,
  "start": 33.66,
  "end": 34.78,
  "text": "看看里面都有什么"
 },
 {
  "i": 22,
  "start": 34.78,
  "end": 36.53,
  "text": "再一个一个挪到对应的位置"
 },
 {
  "i": 23,
  "start": 36.72,
  "end": 38.59,
  "text": "最后回来告诉你已经整理好了"
 },
 {
  "i": 24,
  "start": 38.64,
  "end": 40.31,
  "text": "所以 Agent 最关键的地方"
 },
 {
  "i": 25,
  "start": 40.32,
  "end": 41.67,
  "text": "就是它能自己动手"
 },
 {
  "i": 26,
  "start": 41.84,
  "end": 43.59,
  "text": "它背后其实还是那个大模型"
 },
 {
  "i": 27,
  "start": 43.6,
  "end": 44.91,
  "text": "只是多了两样东西"
 },
 {
  "i": 28,
  "start": 44.96,
  "end": 45.99,
  "text": "一样是工具"
 },
 {
  "i": 29,
  "start": 46.04,
  "end": 48.48,
  "text": "比如读文件 跑代码 上网搜索"
 },
 {
  "i": 30,
  "start": 48.48,
  "end": 49.83,
  "text": "让它能真的去做事"
 },
 {
  "i": 31,
  "start": 50.2,
  "end": 51.47,
  "text": "另一样是一个循环"
 },
 {
  "i": 32,
  "start": 51.6,
  "end": 53.4,
  "text": "它每做完一步都会看看结果"
 },
 {
  "i": 33,
  "start": 53.4,
  "end": 54.76,
  "text": "再决定下一步做什么"
 },
 {
  "i": 34,
  "start": 54.76,
  "end": 56.59,
  "text": "一直重复到任务完成为止"
 },
 {
  "i": 35,
  "start": 56.8,
  "end": 57.72,
  "text": "知道了这一点"
 },
 {
  "i": 36,
  "start": 57.72,
  "end": 59.67,
  "text": "用 Agent 的时候有两个小建议"
 },
 {
  "i": 37,
  "start": 59.84,
  "end": 61.55,
  "text": "第一 把目标说清楚"
 },
 {
  "i": 38,
  "start": 61.56,
  "end": 63.19,
  "text": "不用一步一步教它怎么做"
 },
 {
  "i": 39,
  "start": 63.46,
  "end": 64.49,
  "text": "比如直接告诉它"
 },
 {
  "i": 40,
  "start": 64.5,
  "end": 65.46,
  "text": "把桌面上的文件"
 },
 {
  "i": 41,
  "start": 65.46,
  "end": 67.85,
  "text": "按图片 文档和视频分好类"
 },
 {
  "i": 42,
  "start": 67.98,
  "end": 69.89,
  "text": "它自己就会去想该怎么拆步骤"
 },
 {
  "i": 43,
  "start": 70.14,
  "end": 72.57,
  "text": "第二 给它一个判断做完没有的标准"
 },
 {
  "i": 44,
  "start": 72.62,
  "end": 74.93,
  "text": "比如最后桌面上不能再有散落的文件"
 },
 {
  "i": 45,
  "start": 75.11,
  "end": 76.83,
  "text": "因为它是一轮一轮往前走的"
 },
 {
  "i": 46,
  "start": 76.83,
  "end": 77.86,
  "text": "有了这个标准"
 },
 {
  "i": 47,
  "start": 77.87,
  "end": 79.82,
  "text": "它才知道什么时候该停下来检查"
 },
 {
  "i": 48,
  "start": 79.87,
  "end": 81.47,
  "text": "什么时候才算真的做完了"
 },
 {
  "i": 49,
  "start": 81.47,
  "end": 83.43,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 50,
  "start": 83.43,
  "end": 84.46000000000001,
  "text": "我们下期再见"
 }
]
