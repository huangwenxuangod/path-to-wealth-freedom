[
 {
  "i": 1,
  "start": 0.47,
  "end": 1.62,
  "text": "1997 年 10 月"
 },
 {
  "i": 2,
  "start": 1.67,
  "end": 4.03,
  "text": "戴尔电脑的创始人在一场大会上被问到"
 },
 {
  "i": 3,
  "start": 4.03,
  "end": 5.42,
  "text": "如果让他来管苹果"
 },
 {
  "i": 4,
  "start": 5.47,
  "end": 6.3,
  "text": "他会怎么做"
 },
 {
  "i": 5,
  "start": 6.43,
  "end": 7.27,
  "text": "他的回答是"
 },
 {
  "i": 6,
  "start": 7.27,
  "end": 9.26,
  "text": "把它关掉 把钱还给股东"
 },
 {
  "i": 7,
  "start": 9.35,
  "end": 11.13,
  "text": "可就在今年 7 月"
 },
 {
  "i": 8,
  "start": 11.13,
  "end": 13.6,
  "text": "苹果的市值一度突破了 5 万亿美元"
 },
 {
  "i": 9,
  "start": 13.61,
  "end": 15.96,
  "text": "成了全世界第二家做到这件事的公司"
 },
 {
  "i": 10,
  "start": 16.21,
  "end": 18.16,
  "text": "一家差点被人劝关门的公司"
 },
 {
  "i": 11,
  "start": 18.21,
  "end": 19.76,
  "text": "到底是怎么走到今天的呢"
 },
 {
  "i": 12,
  "start": 19.89,
  "end": 22.2,
  "text": "今年 4 月 1 号 苹果刚好 50 岁"
 },
 {
  "i": 13,
  "start": 22.33,
  "end": 24.12,
  "text": "我们就把这 50 年从头捋一遍"
 },
 {
  "i": 14,
  "start": 24.21,
  "end": 25.64,
  "text": "1976 年 4 月 1 号"
 },
 {
  "i": 15,
  "start": 25.69,
  "end": 28.88,
  "text": "乔布斯、沃兹尼亚克和韦恩签下合伙协议"
 },
 {
  "i": 16,
  "start": 28.97,
  "end": 30.36,
  "text": "苹果就这么成立了"
 },
 {
  "i": 17,
  "start": 30.53,
  "end": 31.73,
  "text": "韦恩只待了 12 天"
 },
 {
  "i": 18,
  "start": 31.73,
  "end": 34.48,
  "text": "就用 800 美元把自己 10% 的股份卖了回去"
 },
 {
  "i": 19,
  "start": 34.66,
  "end": 36.21,
  "text": "因为他担心公司欠了债"
 },
 {
  "i": 20,
  "start": 36.22,
  "end": 37.69,
  "text": "最后要他拿房子来还"
 },
 {
  "i": 21,
  "start": 37.86,
  "end": 39.18,
  "text": "他们接到的第一单生意"
 },
 {
  "i": 22,
  "start": 39.18,
  "end": 41.29,
  "text": "是一家电脑店订的 50 台 Apple I"
 },
 {
  "i": 23,
  "start": 41.34,
  "end": 42.57,
  "text": "为了凑钱买零件"
 },
 {
  "i": 24,
  "start": 42.62,
  "end": 44.29,
  "text": "乔布斯卖掉了自己的面包车"
 },
 {
  "i": 25,
  "start": 44.38,
  "end": 45.93,
  "text": "沃兹卖掉了心爱的计算器"
 },
 {
  "i": 26,
  "start": 46.16,
  "end": 47.32,
  "text": "第二年推出的 Apple II"
 },
 {
  "i": 27,
  "start": 47.32,
  "end": 48.6,
  "text": "让苹果真正火了起来"
 },
 {
  "i": 28,
  "start": 48.6,
  "end": 50.51,
  "text": "1980 年 12 月苹果上市"
 },
 {
  "i": 29,
  "start": 50.56,
  "end": 52.79,
  "text": "一天之内就造出了四十多个百万富翁"
 },
 {
  "i": 30,
  "start": 52.96,
  "end": 55.79,
  "text": "1984 年 苹果在超级碗上播了一支广告"
 },
 {
  "i": 31,
  "start": 55.84,
  "end": 57.59,
  "text": "两天后发布了麦金塔电脑"
 },
 {
  "i": 32,
  "start": 57.75,
  "end": 58.91,
  "text": "它用鼠标点图标"
 },
 {
  "i": 33,
  "start": 58.91,
  "end": 60.46,
  "text": "不用再一行一行地敲命令"
 },
 {
  "i": 34,
  "start": 60.55,
  "end": 62.3,
  "text": "可麦金塔卖得远不如预期"
 },
 {
  "i": 35,
  "start": 62.43,
  "end": 64.67,
  "text": "乔布斯跟自己从百事可乐请来的 CEO"
 },
 {
  "i": 36,
  "start": 64.67,
  "end": 65.67,
  "text": "斯卡利闹翻了"
 },
 {
  "i": 37,
  "start": 65.67,
  "end": 67.62,
  "text": "董事会最后站在了斯卡利那边"
 },
 {
  "i": 38,
  "start": 67.78,
  "end": 70.85,
  "text": "1985 年 30 岁的乔布斯被拿掉了所有实权"
 },
 {
  "i": 39,
  "start": 70.86,
  "end": 72.61,
  "text": "只好离开了自己创办的公司"
 },
 {
  "i": 40,
  "start": 72.86,
  "end": 75.5,
  "text": "接下来的十几年 苹果换了三任 CEO"
 },
 {
  "i": 41,
  "start": 75.5,
  "end": 76.77,
  "text": "产品线越铺越多"
 },
 {
  "i": 42,
  "start": 76.78,
  "end": 78.01,
  "text": "东西却越卖越差"
 },
 {
  "i": 43,
  "start": 78.19,
  "end": 80.94,
  "text": "到了 1997 年 一年就亏掉了十多亿美元"
 },
 {
  "i": 44,
  "start": 81.11,
  "end": 82.98,
  "text": "苹果急着找一套新的操作系统"
 },
 {
  "i": 45,
  "start": 83.03,
  "end": 85.63,
  "text": "最后在 1996 年底 花了大约 4 亿美元"
 },
 {
  "i": 46,
  "start": 85.63,
  "end": 88.06,
  "text": "买下了乔布斯离开后创办的公司 NeXT"
 },
 {
  "i": 47,
  "start": 88.21000000000001,
  "end": 89.68,
  "text": "乔布斯也就跟着回来了"
 },
 {
  "i": 48,
  "start": 89.93,
  "end": 91.81,
  "text": "他回来做的第一件事就是做减法"
 },
 {
  "i": 49,
  "start": 91.81,
  "end": 93.75999999999999,
  "text": "一口气砍掉了七成的产品型号"
 },
 {
  "i": 50,
  "start": 93.81,
  "end": 95.52000000000001,
  "text": "然后又跟老对手微软握手"
 },
 {
  "i": 51,
  "start": 95.53,
  "end": 97.12,
  "text": "拿到了 1.5 亿美元的投资"
 },
 {
  "i": 52,
  "start": 97.13,
  "end": 99.32,
  "text": "还有微软继续给 Mac 做 Office 的承诺"
 },
 {
  "i": 53,
  "start": 99.53999999999999,
  "end": 102.17,
  "text": "1998 年 彩色半透明的 iMac 一上市"
 },
 {
  "i": 54,
  "start": 102.18,
  "end": 103.72999999999999,
  "text": "苹果当年就扭亏为盈"
 },
 {
  "i": 55,
  "start": 103.78,
  "end": 106.85,
  "text": "2001 年 iPod 把一千首歌装进了你的口袋"
 },
 {
  "i": 56,
  "start": 106.97999999999999,
  "end": 109.33,
  "text": "2007 年 1 月 乔布斯在台上说"
 },
 {
  "i": 57,
  "start": 109.34,
  "end": 111.22,
  "text": "今天苹果要重新发明手机"
 },
 {
  "i": 58,
  "start": 111.22,
  "end": 112.61,
  "text": "这台机器就是 iPhone"
 },
 {
  "i": 59,
  "start": 112.78999999999999,
  "end": 114.46000000000001,
  "text": "第二年 App Store 上线"
 },
 {
  "i": 60,
  "start": 114.50999999999999,
  "end": 117.02000000000001,
  "text": "手机从此变成了一台装满应用的口袋电脑"
 },
 {
  "i": 61,
  "start": 117.15,
  "end": 119.5,
  "text": "2011 年 10 月 乔布斯因病去世"
 },
 {
  "i": 62,
  "start": 119.55,
  "end": 121.5,
  "text": "接班的是管供应链出身的库克"
 },
 {
  "i": 63,
  "start": 121.63,
  "end": 123.42,
  "text": "很多人都担心 没了乔布斯"
 },
 {
  "i": 64,
  "start": 123.43,
  "end": 124.86,
  "text": "苹果会不会又走回老路"
 },
 {
  "i": 65,
  "start": 125.04,
  "end": 126.08,
  "text": "结果在库克手里"
 },
 {
  "i": 66,
  "start": 126.08,
  "end": 127.99,
  "text": "iPhone 一直卖到了第 30 亿台"
 },
 {
  "i": 67,
  "start": 128,
  "end": 129.44,
  "text": "2018 年 苹果成了"
 },
 {
  "i": 68,
  "start": 129.44,
  "end": 131.43,
  "text": "第一家市值一万亿美元的上市公司"
 },
 {
  "i": 69,
  "start": 131.52,
  "end": 134.47,
  "text": "2020 年 Mac 也换上了苹果自己设计的芯片"
 },
 {
  "i": 70,
  "start": 134.68,
  "end": 136.35,
  "text": "今年 苹果满了 50 岁"
 },
 {
  "i": 71,
  "start": 136.44,
  "end": 137.87,
  "text": "库克也在 8 月底卸任"
 },
 {
  "i": 72,
  "start": 137.96,
  "end": 141.03,
  "text": "接班的是在苹果干了 25 年的硬件负责人特努斯"
 },
 {
  "i": 73,
  "start": 141.28,
  "end": 143.67000000000002,
  "text": "回头再看 1997 年那句把它关掉"
 },
 {
  "i": 74,
  "start": 143.72,
  "end": 145.51,
  "text": "苹果用了将近 30 年来回答"
 },
 {
  "i": 75,
  "start": 145.52,
  "end": 146.56,
  "text": "而下一个 50 年"
 },
 {
  "i": 76,
  "start": 146.56,
  "end": 148.11,
  "text": "就要交给新的掌舵人了"
 },
 {
  "i": 77,
  "start": 148.18,
  "end": 149.82,
  "text": "OK 本期视频就到这里"
 },
 {
  "i": 78,
  "start": 149.82,
  "end": 150.81,
  "text": "我们下期再见"
 }
]
